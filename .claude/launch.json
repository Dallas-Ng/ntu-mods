{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["dev"],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "Next.js Dev (Worktree)",
      "runtimeExecutable": "bash",
      "runtimeArgs": [".claude/worktree-dev.sh"],
      "port": 3001,
      "autoPort": true,
      "url": "http://localhost:3001"
    },
    {
      "name": "Next.js Start (production)",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["start"],
      "port": 3000,
      "url": "http://localhost:3000"
    }
  ]
}

#!/bin/sh
# Format and lint the files in this commit.
# Installed by `pnpm install` (the prepare script sets core.hooksPath).
# Skip with: git commit --no-verify
set -e

# NUL-separated so filenames with spaces survive.
staged() {
  git diff --cached --name-only --diff-filter=ACMR -z -- "$@"
}

has_staged() {
  git diff --cached --name-only --diff-filter=ACMR -- "$@" | grep -q .
}

# format:staged rewrites the working tree, so stage the result again.
if has_staged '*.ts' '*.tsx' '*.mdx' '*.astro' 'package.json'; then
  pnpm run format:staged
  staged '*.ts' '*.tsx' '*.mdx' '*.astro' 'package.json' | xargs -0 git add --
fi

# oxlint exits non-zero on errors, which aborts the commit. Warnings pass.
if has_staged '*.ts' '*.tsx' '*.astro' '*.js' '*.mjs' '*.cjs' '*.jsx'; then
  staged '*.ts' '*.tsx' '*.astro' '*.js' '*.mjs' '*.cjs' '*.jsx' |
    xargs -0 pnpm exec oxlint
fi

{
  "name": "ntu-mods",
  "version": "0.1.0",
  "private": true,
  "//engines": "yarn build/dev no longer touch node:sqlite (they read src/data/api directly via json-source.ts) - the db: scripts still need it for publishing to D1, which is why this stays >=22.5. See also .node-version, which is what Cloudflare Workers Builds reads.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "data": "tsx scripts/build-static-data.mts",
    "dev": "yarn data && astro dev --port ${PORT:-4321}",
    "build": "yarn data && astro build && node scripts/upload-sourcemaps.mjs && tsx scripts/build-sitemap.mts && node scripts/indexnow.mjs ../dist/client",
    "preview": "astro preview --port ${PORT:-4321}",
    "db:build": "node scripts/db/sync-db.mjs --from json",
    "db:pull": "node scripts/db/sync-db.mjs --from d1",
    "db:dump": "node scripts/db/reseed-d1.mjs",
    "db:seed-local": "yarn db:build && rm -rf .wrangler/state/v3/d1 && node scripts/db/reseed-d1.mjs --max-stmt-bytes 60000 && wrangler d1 migrations apply DB --local && wrangler d1 execute DB --local --file db/out/full.sql",
    "db:load": "node scripts/db/load-semester.mjs",
    "db:verify": "node scripts/db/verify-parity.mjs && npx tsx scripts/db/verify-readers.mts",
    "lint": "eslint . && astro check && tsc",
    "lint:fix": "eslint . --fix",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx,astro}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx,astro}\" --cache",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/markdown-satteri": "0.3.4",
    "@astrojs/react": "^6.0.1",
    "@hookform/resolvers": "^3.3.4",
    "@mlc-ai/web-llm": "^0.2.83",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.2.0",
    "ics": "^3.12.0",
    "lucide-react": "^0.511.0",
    "pdfjs-dist": "^6.4.299",
    "photoswipe": "^5.4.4",
    "posthog-js": "^1.438.12",
    "posthog-node": "^5.56.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.74.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^4.2.4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "vaul": "^1.1.2",
    "wrangler": "4.146.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.64.0",
    "@posthog/cli": "^0.18.10",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-astro": "^1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "eslint-plugin-unused-imports": "4.4.1",
    "fast-check": "^4.10.1",
    "globals": "^16.4.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5",
    "typescript-eslint": "^8.59.1",
    "vitest": "^5.0.0"
  },
  "browserslist": {
    "production": [
      "baseline widely available"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}

/*
  X-Content-Type-Options: nosniff
  Content-Signal: search=yes, ai-input=yes, ai-train=no
  Link: </.well-known/ard.json>; rel="ard", </.well-known/ai-catalog.json>; rel="ai-catalog"
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

/
  ! Link
  Link: </.well-known/api-catalog>; rel="api-catalog", </developers/openapi.json>; rel="service-desc"; type="application/json", </developers/api>; rel="service-doc", </.well-known/ard.json>; rel="ard", </.well-known/ai-catalog.json>; rel="ai-catalog"

/.well-known/api-catalog
  Content-Type: application/linkset+json
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/index.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/ntu-module-lookup/SKILL.md
  Access-Control-Allow-Origin: *

# Rules that match more than one block are joined with commas, so a later
# Cache-Control must detach the one from /* first or both end up in the
# response (e.g. "max-age=3600, ..., no-cache").

# Build output is content-hashed, so a changed file gets a new URL.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/_agent-search/*
  ! Cache-Control
  Cache-Control: no-cache
  X-Robots-Tag: noindex

/*.md
  Content-Type: text/markdown; charset=utf-8

/data/api/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex

# The academic calendar feed. Apps poll it, and it changes about once a year.
/calendar.ics
  ! Cache-Control
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: text/calendar; charset=utf-8
  Access-Control-Allow-Origin: *

/debug
  ! Cache-Control
  Cache-Control: no-cache

# Machine-readable discovery files: any agent or crawler may read them.
/mcp/server-card
  ! Cache-Control
  Cache-Control: public, max-age=3600
  Content-Type: application/mcp-server-card+json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET
  Access-Control-Allow-Headers: Content-Type, If-None-Match
  Access-Control-Expose-Headers: ETag

/.well-known/mcp.json
  ! Cache-Control
  Cache-Control: public, max-age=3600
  Content-Type: application/mcp-server-card+json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET
  Access-Control-Allow-Headers: Content-Type, If-None-Match
  Access-Control-Expose-Headers: ETag

/.well-known/ard.json
  ! Cache-Control
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex

/.well-known/ai-catalog.json
  ! Cache-Control
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/ai-catalog+json; charset=utf-8
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex

/.well-known/security.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

# OpenAI Apps domain verification token. No extension, so set the type.
/.well-known/openai-apps-challenge
  ! Cache-Control
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/.well-known/webmcp.json
  ! Cache-Control
  Cache-Control: public, max-age=3600, s-maxage=86400
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex

/.well-known/poppy.json
  ! Cache-Control
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Link: </.well-known/ai-catalog.json>; rel="ai-catalog"
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

# Rules that match more than one block are joined with commas, so a later
# Cache-Control must detach the one from /* first or both end up in the
# response (e.g. "max-age=3600, ..., no-cache").

# Build output is content-hashed, so a changed file gets a new URL.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/data/api/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *

/debug
  ! Cache-Control
  Cache-Control: no-cache

# Machine-readable discovery files: any agent or crawler may read them.
/.well-known/ai-catalog.json
  ! Cache-Control
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/ai-catalog+json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/webmcp.json
  ! Cache-Control
  Cache-Control: public, max-age=3600, s-maxage=86400
  Access-Control-Allow-Origin: *

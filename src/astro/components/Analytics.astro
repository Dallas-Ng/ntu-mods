---
// GA, shared by both layouts. Rendered only in production — the
// layouts gate on IS_PROD at the call site, because a `<script>` written
// inside an .astro expression has its children treated as raw text rather
// than evaluated, so the tag has to sit at the top level of a component.
//
// The tag ran under next/script's `lazyOnload` before the migration —
// injected after the window load event, so it never competes with hydration
// or LCP. Plain inline tags run during parse instead, which is a real
// regression on mobile, so the deferral is reproduced by hand here. It waits
// for the first interaction or 4 s after load, whichever comes first: the
// 176 KB script costs ~100 ms of main thread even when idle-scheduled.
// Visitors who leave within 4 s without touching the page are not counted.
const GA_ID = "G-70VD9Q58Y0"
---

<script is:inline define:vars={{ GA_ID }}>
  ;(function () {
    function load() {
      var s = document.createElement("script")
      s.async = true
      s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID
      document.head.appendChild(s)

      window.dataLayer = window.dataLayer || []
      function gtag() {
        window.dataLayer.push(arguments)
      }
      window.gtag = gtag
      gtag("js", new Date())
      gtag("config", GA_ID)
    }

    var events = ["pointerdown", "keydown", "scroll", "touchstart"]
    var done = false
    function once() {
      if (done) return
      done = true
      events.forEach(function (e) {
        window.removeEventListener(e, once)
      })
      load()
    }

    function schedule() {
      events.forEach(function (e) {
        window.addEventListener(e, once, { passive: true, once: true })
      })
      setTimeout(once, 4000)
    }

    if (document.readyState === "complete") schedule()
    else window.addEventListener("load", schedule)
  })()
</script>

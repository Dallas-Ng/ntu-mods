---
import { generateTimetableMatrix } from "@/lib/generate-timetable-matrix"
import { breadcrumbListJsonLd, courseJsonLd } from "@/lib/json-ld"
import { getModuleVersionUrl } from "@/lib/module-url"
import type {
  DbExam,
  DbModule,
  DbPrerequisiteNode
} from "@/lib/server/db/types"
import ModsAddToTimetableButton from "@/components/mods/mods-add-to-timetable-button"
import ModsDescription from "@/components/mods/mods-description"
import ModsExpandableFields from "@/components/mods/mods-expandable-fields"
import ModsFavouriteButton from "@/components/mods/mods-favourite-button"
import ModsHeader from "@/components/mods/mods-header"
import ModsIndexTable from "@/components/mods/mods-index-table"
import ModsInfoTable from "@/components/mods/mods-info-table"
import ModsPrerequisiteGraph from "@/components/mods/mods-prerequisite-graph"
import ModsViewTracker from "@/components/mods/mods-view-tracker"
import ModsWorkloadTable from "@/components/mods/mods-workload-table"
import RelatedModules from "@/components/related-modules"
import JsonLd from "@/astro/components/JsonLd.astro"
import { getAllArticles } from "@/astro/lib/articles"

// Shared body for the /mods/[module] "current offering" view — used by both
// the static build (active-semester codes) and the on-demand fallback in
// 404.astro (every other code). Everything here is pure presentation over
// data the caller has already fetched, either from build-time JSON or from
// D1 at request time; this component doesn't know or care which.
interface Props {
  moduleKey: string
  moduleData: DbModule
  year: string
  semester: string
  indexes: Record<string, Index[]>
  exam: DbExam | null
  isCurrentOffering: boolean
  otherSemesters: Array<{ year: string; semester: string }>
  prereqGraph: Record<string, DbPrerequisiteNode>
  prereqNode: DbPrerequisiteNode | null
  related: Array<{ code: string; title: string }>
  relatedArticles: Array<{ href: string; label: string }>
  knownCodes?: string[]
}

const {
  moduleKey,
  moduleData,
  year,
  semester,
  indexes,
  exam,
  isCurrentOffering,
  otherSemesters,
  prereqGraph,
  prereqNode,
  related,
  relatedArticles,
  knownCodes
} = Astro.props

// The graph island only reads titles for this module and the codes it
// renders (requires + first 15 requiredBy). Passing the whole graph inlined
// every module's node into each page's island props (~360KB/page).
const prereqTitles: Record<string, { title: string }> = {}
// Old prerequisite codes that no longer exist as modules (e.g. CV2102) have no
// page to link to, so they are left out of the graph.
const graphNode =
  prereqNode &&
  (() => {
    const requires = prereqNode.requires.filter((c) => prereqGraph[c])
    return requires.length || prereqNode.requiredBy.length
      ? { ...prereqNode, requires }
      : null
  })()
if (graphNode) {
  for (const code of [
    moduleKey,
    ...graphNode.requires,
    ...graphNode.requiredBy.slice(0, 15)
  ]) {
    const title = prereqGraph[code]?.title
    if (title) prereqTitles[code] = { title }
  }
}

const { TABLE_MATRIX, TABLE_MAX_DAY_COLUMNS } = generateTimetableMatrix(
  Object.fromEntries(
    Object.entries(indexes).map(([k, v]) => [k, [...v]])
  ) as Record<string, Index[]>,
  9
)

const allArticles = relatedArticles.length > 0 ? await getAllArticles() : []
const guides = relatedArticles
  .map((r) => allArticles.find((a) => r.href === `/articles/${a.slug}`))
  .filter((a): a is NonNullable<typeof a> => Boolean(a))
  .slice(0, 3)

const semesterLabel = (s: { year: string; semester: string }) => {
  const semName = s.semester === "S" ? "Special Term" : `Semester ${s.semester}`
  return `AY${s.year}/${parseInt(s.year) + 1} ${semName}`
}

const semesterLabelForCurrent = semesterLabel({ year, semester })

const offeringsByYear = otherSemesters.reduce<
  Record<string, Array<{ year: string; semester: string }>>
>((acc, s) => {
  ;(acc[s.year] ??= []).push(s)
  return acc
}, {})
const sortedYears = Object.keys(offeringsByYear).sort((a, b) =>
  b.localeCompare(a)
)

// Course markup says "you can take this"; leave it off modules that are not
// offered this semester.
const jsonLd = [
  isCurrentOffering
    ? courseJsonLd({
        code: moduleKey,
        title: moduleData.title,
        description: moduleData.description || moduleData.title,
        credits: moduleData.au
      })
    : null,
  breadcrumbListJsonLd([
    { name: "Mods", href: "/mods" },
    { name: `${moduleKey} ${moduleData.title}`, href: `/mods/${moduleKey}` }
  ])
]
---

<ModsViewTracker
  client:idle
  moduleCode={moduleKey}
  isCurrentOffering={isCurrentOffering}
/>
{
  !isCurrentOffering && (
    <div class="mb-4 rounded-2xl border border-amber-300 bg-amber-50 px-5 py-3 text-sm text-amber-800 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-300">
      Not offered in the current semester. Last offered{" "}
      {semesterLabelForCurrent}
    </div>
  )
}

<div class="flex flex-col gap-8 xl:flex-row xl:gap-12">
  <div class="w-full space-y-6 xl:w-3/6">
    <ModsHeader
      module={moduleData}
      currentYear={year}
      currentSemester={semester}
      isCurrentOffering={isCurrentOffering}
    />

    <div class="flex gap-2">
      {
        isCurrentOffering && (
          <ModsAddToTimetableButton
            client:load
            moduleKey={moduleKey}
            year={year}
            semester={semester}
            showText={true}
          />
        )
      }
      <ModsFavouriteButton
        client:load
        moduleKey={moduleKey}
        className="hover:bg-accent size-8 shrink-0 rounded-md border"
      />
    </div>

    {
      moduleData.description && (
        <ModsDescription description={moduleData.description} />
      )
    }
  </div>

  <div class="h-fit w-full space-y-4 xl:w-3/6">
    <ModsWorkloadTable indexes={indexes} />

    <ModsInfoTable module={moduleData} exam={exam} knownCodes={knownCodes} />

    <ModsExpandableFields client:idle module={moduleData} />
  </div>
</div>

<div class="mt-12 flex flex-col gap-12">
  {
    graphNode && (
      <ModsPrerequisiteGraph
        client:visible
        moduleCode={moduleKey}
        node={graphNode}
        graph={prereqTitles}
      />
    )
  }

  <section class="space-y-4">
    <h2 class="text-lg font-semibold tracking-tight">Available indexes</h2>
    <ModsIndexTable
      indexes={indexes}
      precomputedMatrix={{ TABLE_MATRIX, TABLE_MAX_DAY_COLUMNS }}
    />
  </section>

  {
    otherSemesters.length > 0 && (
      <section class="space-y-4">
        <h2 class="text-lg font-semibold tracking-tight">Other offerings</h2>
        <div class="rounded-2xl border p-2 text-sm">
          <div class="text-muted-foreground grid grid-cols-[4.5rem_repeat(3,minmax(0,1fr))] items-center gap-1 px-1 pb-1 text-xs font-medium sm:grid-cols-[6rem_repeat(3,minmax(0,1fr))]">
            <span class="px-2">Year</span>
            <span class="text-center">Sem 1</span>
            <span class="text-center">Sem 2</span>
            <span class="text-center">Special</span>
          </div>
          {sortedYears.map((yr) => {
            const sems = offeringsByYear[yr]
            return (
              <div class="grid grid-cols-[4.5rem_repeat(3,minmax(0,1fr))] items-center gap-1 border-t p-1 sm:grid-cols-[6rem_repeat(3,minmax(0,1fr))]">
                <span class="px-2 font-medium whitespace-nowrap">
                  AY{yr.slice(2)}/{String(parseInt(yr) + 1).slice(2)}
                </span>
                {(["1", "2", "S"] as const).map((sem) => {
                  const s = sems.find((o) => o.semester === sem)
                  return s ? (
                    <a
                      href={getModuleVersionUrl(moduleKey, s.year, s.semester)}
                      class="bg-muted hover:bg-accent mx-auto w-16 rounded-full py-1 text-center whitespace-nowrap transition-colors">
                      View
                    </a>
                  ) : (
                    <span class="text-muted-foreground py-1 text-center">
                      -
                    </span>
                  )
                })}
              </div>
            )
          })}
        </div>
      </section>
    )
  }

  <section class="space-y-4">
    <h2 class="text-lg font-semibold tracking-tight">Other relevant mods</h2>
    <RelatedModules
      related={related}
      emptyHref="/mods"
      emptyLabel="No Mods Found. Click here to see all Mods"
    />
  </section>

  {
    guides.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-lg font-semibold tracking-tight">Planning guides</h2>
          <a
            href="/articles"
            class="text-primary text-sm font-medium whitespace-nowrap hover:underline">
            View all articles
          </a>
        </div>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
          {guides.map((g) => (
            <a
              href={g.url}
              class="group bg-muted hover:bg-accent overflow-hidden rounded-2xl transition-colors">
              {g.thumbnail && (
                <img
                  src={g.thumbnail}
                  alt={g.thumbnailAlt}
                  width="640"
                  height="360"
                  loading="lazy"
                  class="aspect-video w-full object-cover"
                />
              )}
              <div class="p-4">
                <p class="text-foreground/70 text-xs">
                  {g.category} · {g.readingTime}
                </p>
                <h3 class="group-hover:text-primary mt-2 line-clamp-2 font-semibold transition-colors">
                  {g.title}
                </h3>
                <p class="text-foreground/80 mt-2 line-clamp-2 text-sm text-pretty">
                  {g.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }
</div>

<JsonLd data={jsonLd} />

---
import { MCP_CLIENTS } from "@/lib/developers/mcp-clients"
import { DEV_LINKS, DEV_NAV } from "@/lib/developers/pages"
import { webPageJsonLd } from "@/lib/json-ld"
import {
  CLAUDE_COLOUR,
  ClaudeIcon,
  CursorIcon,
  OpenAIIcon,
  VSCodeIcon
} from "@/components/brand-icons"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

interface Props {
  /** Page title and description for the head and structured data. */
  title: string
  description: string
  /** Path of this page, as listed in the side nav. */
  path: string
  /** Visible h1 and the line under it. */
  heading: string
  /** Small label above the h1, e.g. the section this page sits in. */
  eyebrow?: string
  intro: string
}

const { title, description, path, heading, eyebrow, intro } = Astro.props
const CLIENT_ICONS: Record<
  string,
  { component: typeof ClaudeIcon; colour?: string }
> = {
  "claude-desktop": { component: ClaudeIcon, colour: CLAUDE_COLOUR },
  "claude-code": { component: ClaudeIcon, colour: CLAUDE_COLOUR },
  "chatgpt-codex": { component: OpenAIIcon },
  cursor: { component: CursorIcon },
  vscode: { component: VSCodeIcon, colour: "#007ACC" }
}
const jsonLd = webPageJsonLd({ name: title, description, path })
---

<BaseLayout
  title={title}
  description={description}
  canonical={path}
  size="full">
  <JsonLd data={jsonLd} />

  <div
    class="grid gap-6 lg:grid-cols-[12rem_minmax(0,1fr)] xl:gap-10 [&>*]:min-w-0">
    <aside class="hidden lg:block">
      <nav aria-label="Developer docs" class="sticky top-24 space-y-5">
        {
          DEV_NAV.map((section) => (
            <div class="space-y-1">
              <p class="text-muted-foreground px-3 text-xs font-semibold">
                {section.title}
              </p>
              <ul class="space-y-0.5">
                {section.items.map((item) =>
                  "subheading" in item ? (
                    <li>
                      <p class="text-muted-foreground px-3 pt-2 text-xs">
                        {item.subheading}
                      </p>
                    </li>
                  ) : "clients" in item ? (
                    <li class="space-y-0.5">
                      <p class="text-muted-foreground px-3 pt-1 text-xs">
                        Adding to
                      </p>
                      <ul class="space-y-0.5">
                        {MCP_CLIENTS.map((c) => {
                          const Icon = CLIENT_ICONS[c.id]
                          const href = `/developers/mcp/${c.id}`
                          return (
                            <li>
                              <a
                                href={href}
                                aria-current={
                                  path === href ? "page" : undefined
                                }
                                class:list={[
                                  "flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors",
                                  path === href
                                    ? "bg-primary/10 text-primary font-medium"
                                    : "text-foreground/80 hover:bg-muted hover:text-foreground"
                                ]}>
                                {Icon && (
                                  <Icon.component
                                    className="size-4 shrink-0"
                                    style={{ color: Icon.colour }}
                                  />
                                )}
                                {c.label}
                              </a>
                            </li>
                          )
                        })}
                      </ul>
                    </li>
                  ) : (
                    <li>
                      <a
                        href={item.href}
                        aria-current={item.href === path ? "page" : undefined}
                        class:list={[
                          "block rounded-md px-3 py-1.5 text-sm transition-colors",
                          item.href === path
                            ? "bg-primary/10 text-primary font-medium"
                            : "text-foreground/80 hover:bg-muted hover:text-foreground"
                        ]}>
                        {item.label}
                      </a>
                    </li>
                  )
                )}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>

    <div class="max-w-3xl min-w-0 space-y-8">
      <div class="space-y-3">
        {eyebrow && <p class="text-sm font-semibold">{eyebrow}</p>}
        <h1 class="text-3xl leading-[1] font-semibold">{heading}</h1>
        <p class="text-foreground/80 text-sm">{intro}</p>
      </div>

      <nav
        aria-label="Developer docs pages"
        class="flex flex-wrap gap-2 lg:hidden">
        {
          DEV_LINKS.map((page) => (
            <a
              href={page.href}
              aria-current={page.href === path ? "page" : undefined}
              class:list={[
                "rounded-full border px-3 py-1 text-sm transition-colors",
                page.href === path
                  ? "bg-primary text-primary-foreground border-primary font-medium"
                  : "hover:bg-muted"
              ]}>
              {page.label}
            </a>
          ))
        }
      </nav>

      <div class="dev-docs space-y-8">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>

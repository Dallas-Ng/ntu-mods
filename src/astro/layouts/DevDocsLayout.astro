---
import { MCP_CLIENTS } from "@/lib/developers/mcp-clients"
import { DEV_LINKS } from "@/lib/developers/pages"
import { htmlHeadings } from "@/lib/html-headings"
import { webPageJsonLd } from "@/lib/json-ld"
import { SideNavDrawer } from "@/components/ui/side-nav-drawer"
import ArticleToc, {
  MobileSectionDropdown
} from "@/components/articles/article-toc"
import Header from "@/components/header"
import DevNav from "@/astro/components/DevNav.astro"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

interface Props {
  /** Page title and description for the head and structured data. */
  title: string
  description: string
  /** Path of this page, as listed in the side nav. */
  path: string
  /** Visible h1 and the line under it. */
  heading: string
  /** Small label above the h1, e.g. the section this page sits in. */
  eyebrow?: string
  intro: string
}

const { title, description, path, heading, eyebrow, intro } = Astro.props
const currentLabel =
  DEV_LINKS.find((link) => link.href === path)?.label ??
  MCP_CLIENTS.find((c) => path === `/developers/mcp/${c.id}`)?.label ??
  "Menu"
const jsonLd = webPageJsonLd({ name: title, description, path })

// Render the page once and list its h2s for "On this page", so each docs
// page gets the right nav without keeping a heading list by hand. The HTML is
// re-emitted with set:html; client:* islands inside still hydrate (checked
// with the code blocks' client:visible), but check again if one is added.
const body = await Astro.slots.render("default")
const headings = htmlHeadings(body)
---

<BaseLayout
  title={title}
  description={description}
  canonical={path}
  size="full">
  <JsonLd data={jsonLd} />

  <div
    class="grid gap-6 lg:grid-cols-[12rem_minmax(0,48rem)] lg:justify-center xl:grid-cols-[12rem_minmax(0,48rem)_14rem] xl:gap-10 [&>*]:min-w-0">
    <aside class="hidden lg:block">
      <DevNav path={path} class="sticky top-24 space-y-5" />
    </aside>

    <div class="flex max-w-3xl min-w-0 flex-col gap-8">
      {
        /* One row under the navbar on phones: the docs menu, then On this page. */
      }
      <div class="sticky top-[4.5rem] z-[5] flex justify-end gap-2 xl:hidden">
        <SideNavDrawer
          client:load
          side="left"
          title="Developer docs"
          label={currentLabel}>
          <DevNav path={path} class="space-y-5" />
        </SideNavDrawer>
        <MobileSectionDropdown
          client:idle
          headings={headings}
          desktopFrom="xl"
          floating={false}
        />
      </div>

      <Header eyebrow={eyebrow} title={heading} subtitle={intro} />

      <div class="dev-docs space-y-8">
        <Fragment set:html={body} />
      </div>
    </div>

    <ArticleToc client:idle headings={headings} desktopFrom="xl" />
  </div>
</BaseLayout>

---
import { ChevronDown } from "lucide-react"

import { MCP_CLIENTS } from "@/lib/developers/mcp-clients"
import { DEV_LINKS } from "@/lib/developers/pages"
import { webPageJsonLd } from "@/lib/json-ld"
import Header from "@/components/header"
import DevNav from "@/astro/components/DevNav.astro"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

interface Props {
  /** Page title and description for the head and structured data. */
  title: string
  description: string
  /** Path of this page, as listed in the side nav. */
  path: string
  /** Visible h1 and the line under it. */
  heading: string
  /** Small label above the h1, e.g. the section this page sits in. */
  eyebrow?: string
  intro: string
}

const { title, description, path, heading, eyebrow, intro } = Astro.props
const currentLabel =
  DEV_LINKS.find((link) => link.href === path)?.label ??
  MCP_CLIENTS.find((c) => path === `/developers/mcp/${c.id}`)?.label ??
  "Menu"
const jsonLd = webPageJsonLd({ name: title, description, path })
---

<BaseLayout
  title={title}
  description={description}
  canonical={path}
  size="full">
  <JsonLd data={jsonLd} />

  <div
    class="grid gap-6 lg:grid-cols-[12rem_minmax(0,1fr)] xl:gap-10 [&>*]:min-w-0">
    <aside class="hidden lg:block">
      <DevNav path={path} class="sticky top-24 space-y-5" />
    </aside>

    <div class="max-w-3xl min-w-0 space-y-8">
      <details class="group rounded-xl border lg:hidden">
        <summary
          class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 [&::-webkit-details-marker]:hidden">
          <span class="flex min-w-0 flex-col">
            <span class="text-muted-foreground text-xs">Developer docs</span>
            <span class="truncate text-sm font-medium">{currentLabel}</span>
          </span>
          <ChevronDown
            class="text-muted-foreground size-4 shrink-0 transition-transform group-open:rotate-180"
          />
        </summary>
        <div class="max-h-[65vh] overflow-y-auto border-t p-2">
          <DevNav path={path} class="space-y-4" />
        </div>
      </details>

      <Header eyebrow={eyebrow} title={heading} subtitle={intro} />

      <div class="dev-docs space-y-8">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>

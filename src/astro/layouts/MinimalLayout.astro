---
import "@/styles/globals.css"

import { siteConfig } from "@/config/site"
import { IS_PROD } from "@/lib/constants"
import { Toaster } from "@/components/ui/sonner"
import AppearanceStyleProvider from "@/components/appearance-style-provider"
import MobileTracker from "@/components/mobile-tracker"

interface Props {
  title?: string
  description?: string
  canonical?: string
  ogImage?: string
}

const defaults = siteConfig.metatags.default
const {
  title = defaults.title,
  description = defaults.desc,
  canonical,
  ogImage = siteConfig.ogImage
} = Astro.props

const canonicalUrl = canonical
  ? new URL(canonical, siteConfig.url).toString()
  : undefined

// Matches Next's root-layout title template (`%s - ${siteConfig.name}`),
// which applies to every page except the homepage.
const resolvedTitle =
  canonical === "/" ? title : `${title} - ${siteConfig.name}`
---

<html lang="en" data-scroll-behavior="smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="white"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="black"
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />

    <script is:inline>
      // Runs before paint to avoid a light/dark flash — theme state lives in
      // localStorage, read by useTheme() (@/hooks/use-theme).
      ;(function () {
        try {
          var t = localStorage.getItem("theme") || "dark"
          var isDark =
            t === "system"
              ? window.matchMedia("(prefers-color-scheme: dark)").matches
              : t === "dark"
          if (isDark) document.documentElement.classList.add("dark")
        } catch (e) {}
      })()
    </script>

    <script>
      import "@/astro/lib/posthog-client-init"
    </script>
  </head>
  <body class="antialiased">
    <AppearanceStyleProvider client:load />
    <slot />
    <MobileTracker client:idle />
    <Toaster client:idle position="top-center" />
    {
      IS_PROD && (
        <>
          <script
            is:inline
            src="https://www.googletagmanager.com/gtag/js?id=G-70VD9Q58Y0"
            async
          />
          <script is:inline id="google-analytics">
            {`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', 'G-70VD9Q58Y0');`}
          </script>
          <script is:inline id="microsoft-clarity">
            {`(function(c,l,a,r,i,t,y){
  c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
  t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
  y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
})(window,document,"clarity","script","k9d6cixduy");`}
          </script>
        </>
      )
    }
  </body>
</html>

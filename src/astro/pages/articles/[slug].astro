---
import { render } from "astro:content"

import { siteConfig } from "@/config/site"
import {
  articleJsonLd,
  breadcrumbListJsonLd,
  collectionPageJsonLd,
  faqPageJsonLd,
  type JsonLd as JsonLdData
} from "@/lib/json-ld"
import { extractFaqItems } from "@/lib/server/articles"
import ArticleToc, {
  MobileSectionDropdown
} from "@/components/articles/article-toc"
import ArticleViewTracker from "@/components/articles/article-view-tracker"
import ArticlesList from "@/components/articles/articles-list"
import Breadcrumbs from "@/components/breadcrumbs"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"
import {
  getAllArticles,
  getArticleCategories,
  getArticleImageUrl,
  getArticlesByCategory,
  slugifyCategory
} from "@/astro/lib/articles"

export const prerender = true

const CATEGORY_META: Record<
  string,
  { title: string; desc: string; heading: string; subheading: string }
> = {
  bde: {
    title: "NTU BDE Guides | NTUMods",
    desc: "Guides on choosing, bidding for, and planning NTU Broadening and Deepening Electives. Find easy BDEs, compare options, and plan around your timetable.",
    heading: "NTU BDE Guides",
    subheading: "Guides on choosing and planning your NTU electives."
  },
  stars: {
    title: "NTU STARS Guides | NTUMods",
    desc: "Guides on NTU STARS course registration: when to bid, how to plan indexes, add/drop strategies, and preparing your backup modules.",
    heading: "NTU STARS Guides",
    subheading: "Guides on STARS bidding and course registration."
  },
  "common-core": {
    title: "NTU Common Core Module Guides | NTUMods",
    desc: "Guides on NTU Common Core modules — what CC0001–CC0007 are like, how to plan your CC requirements, and what to expect from each category.",
    heading: "NTU Common Core Guides",
    subheading: "Guides on NTU Common Core modules and requirements."
  },
  "module-planning": {
    title: "NTU Module Planning Guides | NTUMods",
    desc: "Guides on planning NTU modules: balancing AUs and workload, checking prerequisites, avoiding clashes, and preparing for STARS registration.",
    heading: "NTU Module Planning Guides",
    subheading: "Guides on planning your NTU modules and timetable."
  }
}

export async function getStaticPaths() {
  const articles = await getAllArticles()
  const categories = await getArticleCategories()

  const articleSlugs = new Set(articles.map((article) => article.slug))

  // Articles and category landing pages share the /articles/:slug namespace, so
  // a category whose slug matches an article slug would emit a duplicate param
  // and fail the build. Articles win; surface the clash rather than silently
  // dropping the category page.
  const categorySlugs = categories.map(slugifyCategory)
  const colliding = categorySlugs.filter((slug) => articleSlugs.has(slug))
  if (colliding.length > 0) {
    throw new Error(
      `Article slug(s) collide with category slug(s): ${colliding.join(", ")}. ` +
        `Rename the article or the category so /articles/:slug stays unambiguous.`
    )
  }

  return [
    ...articles.map((article) => ({
      params: { slug: article.slug },
      props: { kind: "article" as const, slug: article.slug }
    })),
    ...categorySlugs.map((slug) => ({
      params: { slug },
      props: { kind: "category" as const, slug }
    }))
  ]
}

const { kind, slug } = Astro.props

// Category branch
let categoryHeading = ""
let categorySubheading = ""
let categoryArticleList: Awaited<ReturnType<typeof getArticlesByCategory>> = []
let categoryLd: JsonLdData | null = null

// Article branch
let article: Awaited<ReturnType<typeof getAllArticles>>[number] | undefined
let moreArticles: Awaited<ReturnType<typeof getAllArticles>> = []
let articleLd: JsonLdData | null = null
let faqLd: JsonLdData | null = null
let breadcrumbLd: JsonLdData | null = null
// One list drives both the visible breadcrumbs and their JSON-LD.
let articleCrumbs: { href: string; label: string; name: string }[] = []
let ArticleContent: Awaited<ReturnType<typeof render>>["Content"] | null = null
let articleHeadings: { id: string; depth: number; text: string }[] = []

if (kind === "category") {
  const categoryArticles = await getArticlesByCategory(slug)
  const meta = CATEGORY_META[slug]
  const categoryName = categoryArticles[0].category
  categoryHeading = meta?.heading ?? `${categoryName} Articles`
  categorySubheading = meta?.subheading ?? `NTUMods guides on ${categoryName}.`
  categoryArticleList = categoryArticles

  categoryLd = [
    collectionPageJsonLd({
      name: categoryHeading,
      description: categorySubheading,
      path: `/articles/${slug}`,
      items: categoryArticles.map((a) => ({
        name: a.title,
        url: `${siteConfig.url}/articles/${a.slug}`
      }))
    }),
    breadcrumbListJsonLd([
      { name: "Articles", href: "/articles" },
      { name: categoryHeading, href: `/articles/${slug}` }
    ])
  ]
} else {
  const articles = await getAllArticles()
  article = articles.find((item) => item.slug === slug)

  if (article) {
    // Rank by shared category/tags first so "More articles" surfaces genuinely
    // related guides instead of whatever happens to be newest.
    const candidates = articles.filter((item) => item.slug !== slug)
    const articleTags = new Set(article.tags ?? [])
    moreArticles = candidates
      .map((item) => {
        const sharedTags = (item.tags ?? []).filter((tag) =>
          articleTags.has(tag)
        ).length
        const sameCategory = item.category === article!.category ? 2 : 0
        return { item, score: sameCategory + sharedTags }
      })
      .sort(
        (a, b) =>
          b.score - a.score ||
          new Date(b.item.date).getTime() - new Date(a.item.date).getTime()
      )
      .slice(0, 3)
      .map(({ item }) => item)

    const rendered = await render(article.entry)
    ArticleContent = rendered.Content
    articleHeadings = rendered.headings.map(
      ({ slug: headingSlug, depth, text }) => ({
        id: headingSlug,
        depth,
        text
      })
    )

    const faqItems = extractFaqItems(article.content)
    faqLd = faqItems.length > 0 ? faqPageJsonLd(faqItems) : null

    articleLd = articleJsonLd({
      headline: article.title,
      description: article.description,
      image: getArticleImageUrl(article.thumbnail),
      datePublished: article.date,
      dateModified: article.updated || article.date,
      author: article.author,
      url: article.url
    })

    articleCrumbs = [
      { href: "/", label: "Home", name: "Home" },
      { href: "/articles", label: "Articles", name: "Articles" },
      {
        href: `/articles/${article.slug}`,
        label: article.title,
        name: article.title
      }
    ]
    breadcrumbLd = breadcrumbListJsonLd(articleCrumbs)
  }
}

if (kind === "article" && !article) {
  return Astro.redirect("/404")
}

const pageTitle =
  kind === "category"
    ? (CATEGORY_META[slug]?.title ?? `${categoryHeading} | NTUMods`)
    : article?.title
const pageDescription =
  kind === "category"
    ? (CATEGORY_META[slug]?.desc ??
      `${categorySubheading} Practical NTU guides, tips and how-tos from NTUMods.`)
    : article?.description
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`/articles/${slug}`}
  size={kind === "category" ? "sm" : "md"}
  article={article && {
    publishedTime: article.date,
    modifiedTime: article.updated || article.date
  }}
  noTitleSuffix>
  {
    kind === "category" ? (
      <>
        <div class="mb-6 sm:mb-8">
          <h1 class="text-3xl leading-[1] font-semibold">{categoryHeading}</h1>
          <p class="text-muted-foreground mt-3">{categorySubheading}</p>
        </div>

        <ArticlesList
          client:load
          articles={categoryArticleList.map(
            ({
              slug: articleSlug,
              title,
              description,
              date,
              category,
              tags,
              thumbnail,
              thumbnailAlt,
              readingTime
            }) => ({
              slug: articleSlug,
              title,
              description,
              date,
              category,
              tags,
              thumbnail,
              thumbnailAlt,
              readingTime
            })
          )}
          categories={[]}
        />

        <JsonLd data={categoryLd} />
      </>
    ) : (
      article && (
        <>
          <div class="grid gap-8 lg:grid-cols-[minmax(0,48rem)_16rem]">
            <Breadcrumbs breadcrumbs={articleCrumbs} />
          </div>

          <JsonLd data={[articleLd, faqLd, breadcrumbLd]} />

          <div class="mt-5 grid gap-8 lg:grid-cols-[minmax(0,48rem)_16rem]">
            <article class="prose dark:prose-invert max-w-full min-w-0">
              <MobileSectionDropdown client:idle headings={articleHeadings} />

              {article.thumbnail && (
                <img
                  src={article.thumbnail}
                  alt={article.thumbnailAlt}
                  class="not-prose mb-5 aspect-video w-full rounded-2xl object-cover sm:mb-6"
                />
              )}

              <div class="text-foreground/70 not-prose mb-6 border-b pb-4 text-sm sm:mb-8 sm:pb-5">
                {new Date(article.date).toLocaleDateString("en-SG", {
                  day: "numeric",
                  month: "long",
                  year: "numeric"
                })}{" "}
                · {article.readingTime} · {article.author}
                <ArticleViewTracker client:idle slug={slug} />
              </div>

              {ArticleContent && <ArticleContent />}
            </article>

            <ArticleToc client:idle headings={articleHeadings} />
          </div>

          {moreArticles.length > 0 && (
            <section class="mx-auto mt-10 max-w-3xl border-t pt-6 sm:mt-12 sm:pt-8">
              <div class="flex items-baseline justify-between gap-3">
                <h2 class="text-xl font-semibold tracking-normal">
                  More articles
                </h2>
                <a
                  href="/articles"
                  class="text-primary text-sm underline-offset-4 hover:underline">
                  View all articles
                </a>
              </div>
              <div class="mt-4 grid gap-3 sm:grid-cols-3">
                {moreArticles.map((item) => (
                  <a
                    href={`/articles/${item.slug}`}
                    class="group bg-muted hover:bg-accent overflow-hidden rounded-2xl transition-colors">
                    {item.thumbnail && (
                      <img
                        src={item.thumbnail}
                        alt={item.thumbnailAlt}
                        loading="lazy"
                        class="aspect-video w-full object-cover"
                      />
                    )}
                    <div class="p-3">
                      <div class="text-foreground/70 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs">
                        <span class="bg-background text-muted-foreground rounded px-1.5 py-0.5">
                          {item.category}
                        </span>
                        <span>{item.readingTime}</span>
                      </div>
                      <p class="group-hover:text-primary mt-2 line-clamp-2 text-sm font-medium break-words transition-colors">
                        {item.title}
                      </p>
                      <p class="text-foreground/80 mt-1.5 line-clamp-2 text-xs leading-5 break-words">
                        {item.description}
                      </p>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          )}
        </>
      )
    )
  }
</BaseLayout>

<script>
  import PhotoSwipe from "photoswipe"

  import "photoswipe/style.css"

  // Edge fades on article tables: flag which sides of each scroll box still
  // have content, so globals.css can fade that edge.
  document.querySelectorAll<HTMLElement>(".table-wrap").forEach((wrap) => {
    const scroller = wrap.querySelector<HTMLElement>(".table-scroll")
    if (!scroller) return

    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth
      const sides = []
      if (scroller.scrollLeft > 2) sides.push("left")
      if (scroller.scrollLeft < max - 2) sides.push("right")
      wrap.dataset.more = sides.join(" ")
    }

    update()
    scroller.addEventListener("scroll", update, { passive: true })

    // Watch the table too: its width can change (late fonts or images in
    // cells) without the scroll box itself resizing.
    const observer = new ResizeObserver(update)
    observer.observe(scroller)
    if (scroller.firstElementChild) observer.observe(scroller.firstElementChild)
  })

  // Body figures only; the not-prose hero thumbnail is excluded by the selector.
  // Lightbox with wheel / double-click / pinch zoom and drag-to-pan, so the
  // screenshots can be read at full resolution, not just enlarged to fit.
  document
    .querySelectorAll<HTMLImageElement>("article.prose figure img")
    .forEach((img) => {
      img.addEventListener("click", () => {
        new PhotoSwipe({
          dataSource: [
            {
              src: img.currentSrc || img.src,
              width: img.naturalWidth,
              height: img.naturalHeight,
              alt: img.alt
            }
          ],
          wheelToZoom: true,
          maxZoomLevel: 3,
          showHideAnimationType: "fade",
          bgOpacity: 0.92
        }).init()
      })
    })
</script>

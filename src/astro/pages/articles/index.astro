---
import { siteConfig } from "@/config/site"
import ArticlesList from "@/components/articles/articles-list"
import Header from "@/components/header"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"
import { getAllArticles, getArticleCategories } from "@/astro/lib/articles"

export const prerender = true

const articles = await getAllArticles()
const categories = await getArticleCategories()
const articleList = articles.map(
  ({
    slug,
    title,
    description,
    date,
    category,
    tags,
    thumbnail,
    thumbnailAlt,
    readingTime
  }) => ({
    slug,
    title,
    description,
    date,
    category,
    tags,
    thumbnail,
    thumbnailAlt,
    readingTime
  })
)
---

<BaseLayout
  title={siteConfig.metatags.articles.title}
  description={siteConfig.metatags.articles.desc}
  canonical="/articles"
  ogImage={`${siteConfig.url}/og/articles.png`}
  size="md"
  containerClassName="space-y-3">
  <Header
    title="Articles"
    subtitle="Guides, updates, and notes from NTUMods."
  />
  <ArticlesList articles={articleList} categories={categories} client:load />
</BaseLayout>

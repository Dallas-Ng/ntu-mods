---
import { siteConfig } from "@/config/site"
import { collectionPageJsonLd } from "@/lib/json-ld"
import ArticlesList from "@/components/articles/articles-list"
import Header from "@/components/header"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"
import {
  getAllArticles,
  getArticleCategories,
  slugifyCategory
} from "@/astro/lib/articles"

export const prerender = true

const articles = await getAllArticles()
const categories = await getArticleCategories()
const articleList = articles.map(
  ({
    slug,
    title,
    description,
    date,
    category,
    tags,
    thumbnail,
    thumbnailAlt,
    thumbnailText,
    readingTime
  }) => ({
    slug,
    title,
    description,
    date,
    category,
    tags,
    thumbnail,
    thumbnailAlt,
    thumbnailText,
    readingTime
  })
)

const articlesJsonLd = collectionPageJsonLd({
  name: siteConfig.metatags.articles.title,
  description: siteConfig.metatags.articles.desc,
  path: "/articles",
  items: articleList.map(({ slug, title }) => ({
    name: title,
    url: `${siteConfig.url}/articles/${slug}`
  }))
})
---

<BaseLayout
  handFont
  title={siteConfig.metatags.articles.title}
  description={siteConfig.metatags.articles.desc}
  canonical="/articles"
  ogImage={`${siteConfig.url}/og/articles.png`}
  ogImageAlt="NTUMods guides for NTU students, including NTULearn, FGO and degree audit"
  size="md"
  containerClassName="space-y-3">
  <JsonLd data={articlesJsonLd} />
  <Header
    title="Articles"
    subtitle="Guides, updates, and notes from NTUMods."
  />
  <ArticlesList articles={articleList} categories={categories} client:load />
  <nav aria-label="Browse by topic" class="pt-4 text-sm">
    <span class="text-foreground/70">Browse by topic: </span>
    {
      categories.map((category, i) => (
        <>
          {i > 0 && ", "}
          <a
            href={`/articles/${slugifyCategory(category)}`}
            class="text-primary underline-offset-4 hover:underline">
            {category}
          </a>
        </>
      ))
    }
  </nav>
</BaseLayout>

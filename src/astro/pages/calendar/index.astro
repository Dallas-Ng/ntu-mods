---
import { siteConfig } from "@/config/site"
import {
  getAllAcademicYearCalendars,
  type AcademicYearCalendar
} from "@/lib/academic-calendar"
import {
  addDays,
  parseLocalDate,
  semesterName,
  toIsoDate
} from "@/lib/academic-calendar-events"
import {
  formatDayMonth,
  formatRange,
  weekdayShort
} from "@/lib/calendar-format"
import { datasetJsonLd } from "@/lib/json-ld"
import { buttonVariants } from "@/components/ui/button"
import { cardVariants } from "@/components/ui/card"
import {
  ExternalLinkIcon,
  LinkArrow,
  TextLink
} from "@/components/ui/text-link"
import { Alert, AlertDescription } from "@/components/ui/alert"
import CalendarStatus from "@/components/calendar/calendar-status"
import Header, { SectionHeading } from "@/components/header"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const OFFICIAL_PAGE =
  "https://www.ntu.edu.sg/admissions/matriculation/academic-calendars"

const EXTERNAL = "inline-flex items-center gap-0.5"

const calendars = getAllAcademicYearCalendars()
// Confirmed years first; a provisional year is shown after them.
const years = [
  ...calendars.filter((c) => !c.indicative),
  ...calendars.filter((c) => c.indicative)
]
const yearLabel = (c: AcademicYearCalendar) =>
  `AY${c.academicYear}/${String(c.academicYear + 1).slice(2)}`
const confirmed = years.filter((c) => !c.indicative).map(yearLabel)

const { title, desc } = siteConfig.metatags.calendar

interface Row {
  label: string
  dates: string
  notes: string[]
  shaded?: boolean
}

/** What changes for classes on the days from `start` to `end` inclusive. */
const notesFor = (c: AcademicYearCalendar, start: string, end: string) => {
  const within = (d: string) => start <= d && d <= end
  const day = (d: string) => `${weekdayShort(d)} ${formatDayMonth(d)}`
  const notes: [string, string][] = [
    ...c.noClassDays
      // Weekend holidays change nothing for classes (a Sunday one has its own
      // Monday replacement entry).
      .filter(
        (d) => within(d.date) && !["Sat", "Sun"].includes(weekdayShort(d.date))
      )
      .map((d): [string, string] => [
        d.date,
        `${day(d.date)}: ${d.name}, no classes`
      ]),
    ...c.earlyDismissals
      .filter((d) => within(d.date))
      .map((d): [string, string] => [
        d.date,
        `${day(d.date)}: classes end at ${d.until} (${d.name})`
      ]),
    ...c.events
      .filter((e) => e.noClasses && within(e.start))
      .map((e): [string, string] => [
        e.start,
        `${day(e.start)}: ${e.name}, no classes ${e.noClasses?.from} to ${e.noClasses?.to}`
      ])
  ]
  return notes.sort(([a], [b]) => a.localeCompare(b)).map(([, text]) => text)
}

const semesterRows = (c: AcademicYearCalendar, code: string): Row[] => {
  const sem = c.semesters[code]
  const rows: Row[] = []
  for (const [week, monday] of Object.entries(sem.teachingWeeks).sort(
    ([a], [b]) => Number(a) - Number(b)
  )) {
    const friday = toIsoDate(addDays(parseLocalDate(monday), 4))
    if (week === "8" && sem.recess) {
      rows.push({
        label: "Recess week",
        dates: formatRange(sem.recess.start, sem.recess.end),
        notes: notesFor(c, sem.recess.start, sem.recess.end),
        shaded: true
      })
    }
    rows.push({
      label: `Week ${week}`,
      dates: formatRange(monday, friday),
      notes: notesFor(c, monday, friday)
    })
  }
  if (sem.revisionAndExams) {
    const { start, end } = sem.revisionAndExams
    rows.push({
      label: "Revision and exams",
      dates: formatRange(start, end),
      notes: notesFor(c, start, end),
      shaded: true
    })
  }
  return rows
}

/** How a holiday affects classes, from the no-class days NTU marks. */
const holidayEffect = (
  c: AcademicYearCalendar,
  h: AcademicYearCalendar["publicHolidays"][number]
) => {
  const replacement = c.noClassDays.find(
    (d) => d.name === `${h.name} (replacement holiday)`
  )
  if (replacement)
    return `Replacement holiday on ${weekdayShort(replacement.date)} ${formatDayMonth(replacement.date)}: no classes`
  const days = [weekdayShort(h.start), weekdayShort(h.end)]
  if (days.every((d) => d === "Sat" || d === "Sun"))
    return "Weekend, no replacement holiday for classes"
  const sems = Object.values(c.semesters)
  const teaching = sems.some(({ teachingWeeks: w }) => {
    const last = w["13"]
    return (
      w["1"] &&
      last &&
      w["1"] <= h.start &&
      h.start <= toIsoDate(addDays(parseLocalDate(last), 4))
    )
  })
  if (teaching) return "No classes"
  const exams = sems.some(
    ({ revisionAndExams: r }) => r && r.start <= h.start && h.start <= r.end
  )
  return exams ? "During the revision and exam weeks" : "Between semesters"
}

const latest = years[0]
const structuredData = latest
  ? datasetJsonLd({
      name: `NTU academic calendar ${yearLabel(latest)}`,
      description: `Teaching weeks, recess, revision and exam weeks, public holidays and key events for ${yearLabel(latest)} at Nanyang Technological University, read from NTU's official calendar.`,
      path: "/calendar",
      source: latest.source ?? OFFICIAL_PAGE,
      downloads: [
        { name: "NTU academic calendar (JSON)", url: "/data/api/calendar.json" }
      ]
    })
  : null
---

<BaseLayout
  title={title}
  description={desc}
  canonical="/calendar"
  size="md"
  containerClassName="space-y-8">
  <JsonLd data={structuredData} />
  <Header
    title="NTU academic calendar"
    subtitle={confirmed.length > 0
      ? `Teaching weeks, recess, exam weeks and public holidays for ${confirmed.join(" and ")}, from NTU's official calendar.`
      : "NTU has not published a confirmed calendar yet."}
  />

  <CalendarStatus client:load calendars={calendars} />

  {
    years.map((c) => (
      <section class="space-y-6" aria-labelledby={`ay${c.academicYear}`}>
        <SectionHeading id={`ay${c.academicYear}`}>
          {yearLabel(c)}
          {c.indicative ? " (provisional)" : ""}
        </SectionHeading>
        {c.indicative && (
          <Alert variant="warning" role="note">
            <AlertDescription>
              NTU has only published an indicative calendar for this year. The
              dates may change when NTU confirms it.
            </AlertDescription>
          </Alert>
        )}

        {Object.keys(c.semesters).map((code) => (
          <div class="space-y-3">
            <SectionHeading
              as="h3"
              id={`ay${c.academicYear}-s${code.split(";")[1]}`}>
              {semesterName(code)}
            </SectionHeading>
            <div class="overflow-x-auto">
              <table class="data-table w-full text-sm">
                <thead>
                  <tr>
                    <th scope="col">Week</th>
                    <th scope="col">Dates</th>
                    <th scope="col">Changes to classes</th>
                  </tr>
                </thead>
                <tbody>
                  {semesterRows(c, code).map((row) => (
                    <tr class:list={[row.shaded && "[&>td]:bg-muted!"]}>
                      <td class="font-medium whitespace-nowrap">{row.label}</td>
                      <td class="whitespace-nowrap tabular-nums">
                        {row.dates}
                      </td>
                      <td>
                        {row.notes.length > 0 ? (
                          <ul class="space-y-1">
                            {row.notes.map((n) => (
                              <li>{n}</li>
                            ))}
                          </ul>
                        ) : (
                          <span class="text-muted-foreground">None</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}

        <div class="space-y-3">
          <SectionHeading as="h3" id={`ay${c.academicYear}-holidays`}>
            Public holidays
          </SectionHeading>
          <div class="overflow-x-auto">
            <table class="data-table w-full text-sm">
              <thead>
                <tr>
                  <th scope="col">Holiday</th>
                  <th scope="col">Date</th>
                  <th scope="col">Classes</th>
                </tr>
              </thead>
              <tbody>
                {c.publicHolidays.map((h) => (
                  <tr>
                    <td class="font-medium">{h.name}</td>
                    <td class="whitespace-nowrap tabular-nums">
                      {weekdayShort(h.start)}
                      {h.end !== h.start
                        ? ` to ${weekdayShort(h.end)}`
                        : ""}{" "}
                      {formatRange(h.start, h.end)}
                    </td>
                    <td>{holidayEffect(c, h)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {c.earlyDismissals.length > 0 && (
            <p class="text-muted-foreground text-sm text-pretty">
              Classes end at {c.earlyDismissals[0].until} on{" "}
              {c.earlyDismissals
                .map((d) => `${weekdayShort(d.date)} ${formatDayMonth(d.date)}`)
                .join(", ")}
              , the eves of{" "}
              {c.earlyDismissals
                .map((d) => d.name.replace(/^Eve of /, ""))
                .join(", ")}
              .
            </p>
          )}
        </div>

        {c.events.length > 0 && (
          <div class="space-y-3">
            <SectionHeading as="h3" id={`ay${c.academicYear}-events`}>
              Key events
            </SectionHeading>
            <div class="overflow-x-auto">
              <table class="data-table w-full text-sm">
                <thead>
                  <tr>
                    <th scope="col">Event</th>
                    <th scope="col">Date</th>
                  </tr>
                </thead>
                <tbody>
                  {[...c.events]
                    .sort((a, b) => a.start.localeCompare(b.start))
                    .map((e) => (
                      <tr>
                        <td class="font-medium">
                          {e.name}
                          {e.note && (
                            <span class="text-muted-foreground block text-xs font-normal">
                              {e.note}
                            </span>
                          )}
                        </td>
                        <td class="whitespace-nowrap tabular-nums">
                          {formatRange(e.start, e.end)}
                        </td>
                      </tr>
                    ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </section>
    ))
  }

  <div
    class:list={[
      cardVariants(),
      "flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"
    ]}>
    <div class="min-w-0 space-y-1">
      <p class="text-xl font-bold tracking-tight">Plan around the calendar</p>
      <p class="text-muted-foreground text-sm text-pretty">
        Registration, add/drop and what each part of the semester is like.
      </p>
    </div>
    <a
      href="/articles/ntu-academic-calendar-ay2026"
      class={buttonVariants({ size: "lg", className: "group shrink-0" })}>
      Read the guide
      <LinkArrow />
    </a>
  </div>

  <footer class="space-y-2 border-t pt-4 text-sm">
    <p class="text-pretty">
      Source:{" "}
      <TextLink href={latest?.source ?? OFFICIAL_PAGE} className={EXTERNAL}>
        NTU's official academic calendar{latest?.source ? " (PDF)" : ""}
        <ExternalLinkIcon className="size-4" />
      </TextLink>
      . NTU states that all dates may change. Classes on public holidays are not held,
      and a Sunday holiday moves to the Monday after it.
    </p>
    <ul aria-label="Calendar downloads" class="flex flex-wrap gap-x-4 gap-y-2">
      <li>
        <TextLink href="/data/api/calendar.json"
          >Academic calendar (JSON)</TextLink
        >
      </li>
      <li>
        <TextLink href="/calendar.ics">Academic calendar (.ics)</TextLink>
      </li>
      <li>
        <TextLink href={OFFICIAL_PAGE} className={EXTERNAL}>
          All NTU calendars
          <ExternalLinkIcon className="size-4" />
        </TextLink>
      </li>
    </ul>
  </footer>
</BaseLayout>

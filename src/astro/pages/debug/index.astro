---
import { siteConfig } from "@/config/site"
import DebugContent from "@/components/debug/debug-content"
import Header from "@/components/header"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const isDev = import.meta.env.DEV
---

<BaseLayout
  title={siteConfig.metatags.debug.title}
  description={siteConfig.metatags.debug.desc}
  canonical="/debug">
  <div class="flex flex-col gap-4">
    <Header title="Debug" />

    {
      isDev && (
        <div class="flex gap-2">
          <div class="bg-background h-[50px] w-[200px]">bg-background</div>
          <div class="bg-foreground h-[50px] w-[200px] text-white">
            bg-foreground
          </div>
          <div class="bg-primary h-[50px] w-[200px]">bg-primary</div>
          <div class="bg-secondary-foreground h-[50px] w-[200px]">
            bg-secondary-foreground
          </div>
          <div class="bg-secondary h-[50px] w-[200px]">bg-secondary</div>
          <div class="bg-muted-foreground h-[50px] w-[200px]">
            bg-muted-foreground
          </div>
          <div class="bg-muted h-[50px] w-[200px]">bg-muted</div>
          <div class="bg-accent h-[50px] w-[200px]">bg-accent</div>
        </div>
      )
    }
    <DebugContent client:load />
  </div>
</BaseLayout>

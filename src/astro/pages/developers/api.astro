---
import { siteConfig } from "@/config/site"
import { getApiGroups } from "@/lib/developers/api-groups"
import ApiExplorer from "@/components/developers/api-explorer"
import DevDocsLayout from "@/astro/layouts/DevDocsLayout.astro"

export const prerender = true

const { title, desc } = siteConfig.metatags.developersApi

const groups = (await getApiGroups()).filter((g) => g.name !== "Discovery")
---

<DevDocsLayout
  title={title}
  description={desc}
  path="/developers/api"
  heading="REST API and open data"
  intro="One module as JSON, and whole-dataset JSON files for modules, class indexes and exams. Free, read-only and no key.">
  <p>
    Every endpoint is a plain <code>GET</code>. A machine-readable <a
      href="/developers/openapi.json">OpenAPI 3.1 file</a
    > is available. For an AI assistant, see the <a href="/developers/mcp"
      >MCP server</a
    >.
  </p>

  <div>
    <ApiExplorer client:load groups={groups} />
  </div>
</DevDocsLayout>

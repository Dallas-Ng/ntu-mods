---
import { siteConfig } from "@/config/site"
import { DEV_PAGES } from "@/lib/developers/pages"
import HeadingAnchor from "@/components/heading-anchor"
import DevDocsLayout from "@/astro/layouts/DevDocsLayout.astro"

export const prerender = true

const { title, desc } = siteConfig.metatags.developers

const practices: [string, string][] = [
  [
    "Cache what you fetch.",
    "Course data changes a few times a semester, so store responses instead of asking again."
  ],
  [
    "Download files for bulk work.",
    "If you need many modules, download `/data/api/modules.json` or a semester file once. Do not call `/api/modules/{code}` in a loop."
  ],
  [
    "Keep your request rate modest.",
    "Space requests out and avoid bursts of parallel calls."
  ],
  [
    "Back off on errors.",
    "On `429` or `503`, wait the number of seconds in the `Retry-After` header before you retry. Never retry in a tight loop."
  ],
  [
    "Use the canonical URL.",
    "Send an uppercase module code with no query string, so you skip the `308` redirect."
  ],
  [
    "Do not abuse the service.",
    "Do not try to overload it, get around its limits or probe other routes, and do not use it to harm others."
  ],
  [
    "Tell your users the data can be wrong.",
    "Show how fresh your copy is and point them to STARS for anything that affects registration."
  ]
]
---

<DevDocsLayout
  title={title}
  description={desc}
  path="/developers"
  heading="Developers"
  intro="A free, read-only API, open data and MCP server for NTU modules, class indexes and exams.">
  <section class="space-y-3" aria-labelledby="start">
    <h2 id="start">
      Where to start<HeadingAnchor id="start" label="Where to start" />
    </h2>
    <div class="grid gap-3">
      {
        DEV_PAGES.filter((page) => page.href !== "/developers").map((page) => (
          <a
            href={page.href}
            class="hover:bg-muted space-y-1 rounded-2xl border p-4 transition-colors">
            <span class="block font-semibold">{page.label}</span>
            <span class="text-foreground block text-sm">
              {page.description}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="space-y-3" aria-labelledby="terms">
    <h2 id="terms">
      Terms of use (no opt out)<HeadingAnchor
        id="terms"
        label="Terms of use (no opt out)"
      />
    </h2>
    <div class="bg-primary-subtle space-y-3 rounded-2xl border p-5 text-sm">
      <p>
        By using any API, file or the MCP server on this page, you accept these
        terms. There is no opt out. If you do not accept them, do not use them.
      </p>
      <ul>
        <li>
          You use these APIs entirely at your own risk. The owner of NTUMods is
          not responsible for, and is not implicated in, anything you build or
          do with them.
        </li>
        <li>
          The owner can change, restrict or remove any API, dataset or response
          format at any time, without notice.
        </li>
      </ul>
    </div>
  </section>

  <section class="space-y-3" aria-labelledby="basics">
    <h2 id="basics">
      Basics<HeadingAnchor id="basics" label="Basics" />
    </h2>
    <ul>
      <li>
        Free to use. No API key and no sign-up. Every endpoint is a plain <code
          >GET</code
        >, except the MCP server, which takes <code>POST</code>.
      </li>
      <li>
        The data is NTU public course data. It can be out of date or wrong, so
        always check STARS before you rely on it.
      </li>
      <li>
        A machine-readable <a href="/developers/openapi.json"
          >OpenAPI 3.1 file</a
        > is available.
      </li>
    </ul>
  </section>

  <section class="space-y-3" aria-labelledby="practices">
    <h2 id="practices">
      Best practices<HeadingAnchor id="practices" label="Best practices" />
    </h2>
    <ul>
      {
        practices.map(([lead, body]) => (
          <li>
            <Fragment
              set:html={`${lead} ${body}`.replace(
                /`([^`]+)`/g,
                "<code>$1</code>"
              )}
            />
          </li>
        ))
      }
    </ul>
  </section>
</DevDocsLayout>

---
import { siteConfig } from "@/config/site"
import { webPageJsonLd } from "@/lib/json-ld"
import { MCP_TOOLS } from "@/lib/mcp/tools"
import { buildOpenApi } from "@/lib/openapi"
import { getLatestExamSemester, getLatestSemester } from "@/lib/server/db/repo"
import ArticleToc, {
  MobileSectionDropdown
} from "@/components/articles/article-toc"
import ApiExplorer from "@/components/developers/api-explorer"
import type { ApiGroup } from "@/components/developers/api-explorer"
import { Code } from "@/components/developers/code"
import HeadingAnchor from "@/components/heading-anchor"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const { title, desc } = siteConfig.metatags.developers

const { year, semester } = await getLatestSemester()
const exams = await getLatestExamSemester()
const spec = buildOpenApi({
  indexSemester: `${year}_${semester}`,
  examSemester: exams ? `${exams.year}_${exams.semester}` : null
})

type Schema = Record<string, any>
const schemas = spec.components.schemas as Record<string, Schema>
const resolve = (s: Schema): Schema =>
  s?.$ref ? schemas[s.$ref.split("/").pop() as string] : s

const typeOf = (s: Schema): string => {
  if (s.$ref) return s.$ref.split("/").pop() as string
  if (s.oneOf) return s.oneOf.map(typeOf).join(" | ")
  if (s.type === "array") return `${typeOf(s.items ?? {})}[]`
  return Array.isArray(s.type) ? s.type.join(" | ") : (s.type ?? "any")
}

// Flattens an object schema one level deep into table rows.
const fields = (schema: Schema, prefix = ""): [string, string, string][] =>
  Object.entries(resolve(schema).properties ?? {}).flatMap(([name, raw]) => {
    const prop = raw as Schema
    const inner = resolve(prop)
    if (!prefix && inner.type === "object" && inner.properties) {
      return [
        [name, "object", prop.description ?? ""],
        ...fields(inner, `${name}.`)
      ] as [string, string, string][]
    }
    return [[prefix + name, typeOf(prop), prop.description ?? ""]] as [
      string,
      string,
      string
    ][]
  })

const moduleSchema = spec.paths["/api/modules/{code}"].get.responses["200"]
  .content["application/json"].schema as Schema

// Field tables for the module API and the open data files, with where the
// fields sit in the response. Discovery files have none.
const FIELD_DOCS: Record<string, { schema: Schema; note?: string }> = {
  getModule: { schema: moduleSchema },
  getModuleList: {
    schema: schemas.ModuleList.properties.modules.items,
    note: "Each item in the `modules` array."
  },
  getIndexes: {
    schema: schemas.ClassSlot,
    note: "Each class slot, found at `{code}.{index}[]`."
  },
  getExams: {
    schema: schemas.Exam,
    note: "Each exam, found at `{code}`."
  }
}

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC"
  })

const LANG: Record<string, string> = {
  "application/json": "json",
  "text/markdown": "markdown",
  "text/plain": "text"
}

const groups: ApiGroup[] = spec.tags.map((tag) => ({
  name: tag.name,
  description: tag.description,
  ops: Object.entries(spec.paths).flatMap(([path, item]) => {
    const op = (item as Record<string, any>).get as Schema
    if (op.tags[0] !== tag.name) return []
    const [mediaType, media] = (Object.entries(
      op.responses["200"]?.content ?? {}
    )[0] ?? []) as [string | undefined, Schema | undefined]
    const isModule = op.operationId === "getModule"
    const fieldDocs = FIELD_DOCS[op.operationId]
    const examplePath = path.replace(
      /\{(\w+)\}/g,
      (_, name) =>
        op.parameters.find((p: Schema) => p.name === name).schema.example
    )
    return [
      {
        id: op.operationId,
        path,
        summary: op.summary,
        description: op.description,
        updated: formatDate(op["x-last-updated"]),
        params: (op.parameters ?? []).map((p: Schema) => ({
          name: p.name,
          where: p.in,
          description: p.description ?? p.schema.description ?? "",
          pattern: p.schema.pattern,
          example: p.schema.example
        })),
        responses: Object.entries(op.responses).map(([status, r]) => ({
          status,
          description: (r as Schema).description
        })),
        fields: fieldDocs ? fields(fieldDocs.schema) : undefined,
        fieldsNote: fieldDocs?.note,
        request: `curl ${spec.servers[0].url}${examplePath}`,
        response:
          media?.["x-example-text"] ??
          (media?.example ? JSON.stringify(media.example, null, 2) : undefined),
        responseLang: LANG[mediaType ?? ""] ?? "text",
        tryIt: isModule
      }
    ]
  })
}))

// The MCP tool reference is built from the same definitions the /mcp route
// registers, so this table cannot disagree with the server.
const mcpUrl = `${siteConfig.url}/mcp`
const mcpTools = MCP_TOOLS.map((tool) => {
  const schema = tool.inputSchema as {
    properties: Record<string, Schema>
    required: string[]
  }
  return {
    name: tool.name,
    description: tool.description,
    inputs: Object.entries(schema.properties).map(([name, prop]) => ({
      name,
      type: prop.enum ? prop.enum.join(" | ") : typeOf(prop),
      required: schema.required.includes(name),
      description: (prop.description as string | undefined) ?? ""
    }))
  }
})
const claudeCodeCommand = `claude mcp add --transport http ntumods ${mcpUrl}`
const cursorConfig = JSON.stringify(
  { mcpServers: { ntumods: { url: mcpUrl } } },
  null,
  2
)

const practices: [string, string][] = [
  [
    "Cache what you fetch.",
    "Course data changes a few times a semester, so store responses instead of asking again."
  ],
  [
    "Download files for bulk work.",
    "If you need many modules, download `/data/api/modules.json` or a semester file once. Do not call `/api/modules/{code}` in a loop."
  ],
  [
    "Keep your request rate modest.",
    "Space requests out and avoid bursts of parallel calls."
  ],
  [
    "Back off on errors.",
    "On `429` or `503`, wait the number of seconds in the `Retry-After` header before you retry. Never retry in a tight loop."
  ],
  [
    "Use the canonical URL.",
    "Send an uppercase module code with no query string, so you skip the `308` redirect."
  ],
  [
    "Do not abuse the service.",
    "Do not try to overload it, get around its limits or probe other routes, and do not use it to harm others."
  ],
  [
    "Tell your users the data can be wrong.",
    "Show how fresh your copy is and point them to STARS for anything that affects registration."
  ]
]

const jsonLd = webPageJsonLd({
  name: title,
  description: desc,
  path: "/developers"
})

const link = "text-primary underline underline-offset-2"

// Sections for the side nav. The explorer's group ids come from the group names.
const slug = (name: string) => name.toLowerCase().replace(/\s+/g, "-")
const headings = [
  { id: "terms", depth: 2, text: "Terms of use" },
  { id: "basics", depth: 2, text: "Basics" },
  { id: "practices", depth: 2, text: "Best practices" },
  ...groups.map((g) => ({
    id: slug(g.name),
    depth: 2,
    text: g.name,
    count: g.ops.length
  })),
  { id: "mcp", depth: 2, text: "MCP server" },
  { id: "webmcp", depth: 2, text: "AI assistants and WebMCP" }
]
---

<BaseLayout title={title} description={desc} canonical="/developers" size="md">
  <JsonLd data={jsonLd} />

  <MobileSectionDropdown client:idle headings={headings} />

  <div class="grid gap-8 lg:grid-cols-[minmax(0,48rem)_16rem] [&>*]:min-w-0">
    <div class="space-y-8">
      <div class="space-y-3">
        <h1 class="text-3xl leading-[1] font-semibold">Developers</h1>
        <p class="text-foreground/80 text-sm">
          A free, read-only API, open data and MCP server for NTU modules, class
          indexes and exams. Built for student projects and AI tools.
        </p>
      </div>

      <section class="space-y-3" aria-labelledby="terms">
        <h2
          id="terms"
          class="scroll-mt-28 text-lg font-semibold tracking-tight">
          Terms of use (no opt out)<HeadingAnchor
            id="terms"
            label="Terms of use (no opt out)"
          />
        </h2>
        <div class="bg-primary/10 space-y-3 rounded-2xl p-5 text-sm">
          <p>
            By using any API, file or the MCP server on this page, you accept
            these terms. There is no opt out. If you do not accept them, do not
            use them.
          </p>
          <ul class="list-disc space-y-1.5 pl-5">
            <li>
              You use these APIs entirely at your own risk. The owner of NTUMods
              is not responsible for, and is not implicated in, anything you
              build or do with them.
            </li>
            <li>
              The owner can change, restrict or remove any API, dataset or
              response format at any time, without notice.
            </li>
          </ul>
        </div>
      </section>

      <section class="space-y-3" aria-labelledby="basics">
        <h2
          id="basics"
          class="scroll-mt-28 text-lg font-semibold tracking-tight">
          Basics<HeadingAnchor id="basics" label="Basics" />
        </h2>
        <ul class="text-foreground/80 list-disc space-y-1.5 pl-5 text-sm">
          <li>
            Free to use. No API key and no sign-up. Every endpoint is a plain <code
              class="bg-muted rounded px-1 py-0.5 font-mono text-sm">GET</code
            >, except the MCP server, which takes <code
              class="bg-muted rounded px-1 py-0.5 font-mono text-sm">POST</code
            >.
          </li>
          <li>
            The data is NTU public course data. It can be out of date or wrong,
            so always check STARS before you rely on it.
          </li>
          <li>
            A machine-readable <a class={link} href="/developers/openapi.json"
              >OpenAPI 3.1 file</a
            > is available.
          </li>
        </ul>
      </section>

      <section class="space-y-3" aria-labelledby="practices">
        <h2
          id="practices"
          class="scroll-mt-28 text-lg font-semibold tracking-tight">
          Best practices<HeadingAnchor id="practices" label="Best practices" />
        </h2>
        <ul class="text-foreground/80 list-disc space-y-1.5 pl-5 text-sm">
          {
            practices.map(([lead, body]) => (
              <li>
                <Fragment
                  set:html={`${lead} ${body}`.replace(
                    /`([^`]+)`/g,
                    '<code class="bg-muted text-foreground rounded px-1 py-0.5 font-mono text-sm">$1</code>'
                  )}
                />
              </li>
            ))
          }
        </ul>
      </section>

      <div>
        <ApiExplorer client:load groups={groups} />
      </div>

      <section class="space-y-4" aria-labelledby="mcp">
        <h2 id="mcp" class="scroll-mt-28 text-lg font-semibold tracking-tight">
          MCP server<HeadingAnchor id="mcp" label="MCP server" />
        </h2>
        <p class="text-foreground/80 text-sm">
          NTUMods runs a read-only MCP server at <code
            class="bg-muted rounded px-1 py-0.5 font-mono text-sm"
            >{mcpUrl}</code
          >. Add it to Claude, ChatGPT, Claude Code or Cursor and your assistant
          can look up modules, class indexes and exams for you. It serves the
          same data as the API and files above, and needs no sign-in or key. Use
          the API or the data files in your own code, and the MCP server when
          you want an AI assistant to ask the questions.
        </p>

        <h3 class="text-base font-semibold">Connect</h3>
        <ul class="text-foreground/80 list-disc space-y-1.5 pl-5 text-sm">
          <li>
            <strong>Claude</strong> (claude.ai and the desktop app): open Customize,
            then Connectors, then Add custom connector. Enter the URL above, choose
            No sign-in, and add it. Free plans can add one custom connector. On Team
            and Enterprise plans an Owner adds it for the organisation.
          </li>
          <li>
            <strong>ChatGPT</strong>: turn on developer mode, then create an app
            with the URL above and choose No authentication. Which plans have
            developer mode is up to OpenAI, so check your workspace.
          </li>
          <li><strong>Claude Code</strong>: run this command.</li>
        </ul>
        <Code client:visible code={claudeCodeCommand} lang="bash" />
        <p class="text-foreground/80 text-sm">
          <strong>Cursor</strong>: add this to <code
            class="bg-muted rounded px-1 py-0.5 font-mono text-sm"
            >mcp.json</code
          >.
        </p>
        <Code client:visible code={cursorConfig} lang="json" />

        <h3 class="text-base font-semibold">Tools</h3>
        <div class="overflow-x-auto">
          <table class="data-table text-sm!">
            <thead>
              <tr>
                <th>Tool</th>
                <th>What it does</th>
                <th>Inputs</th>
              </tr>
            </thead>
            <tbody>
              {
                mcpTools.map((tool) => (
                  <tr>
                    <td class="whitespace-nowrap">
                      <code class="bg-muted rounded px-1 py-0.5 font-mono text-sm">
                        {tool.name}
                      </code>
                    </td>
                    <td>{tool.description}</td>
                    <td class="space-y-1">
                      {tool.inputs.length === 0 && "None"}
                      {tool.inputs.map((input) => (
                        <div>
                          <code class="bg-muted rounded px-1 py-0.5 font-mono text-sm">
                            {input.name}
                          </code>{" "}
                          <span class="text-muted-foreground">
                            {input.type}
                            {input.required ? ", required" : ""}.
                          </span>{" "}
                          {input.description}
                        </div>
                      ))}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="text-foreground/80 text-sm">
          Your timetable, plans, favourites and CGPA live in your own browser,
          so the MCP server cannot see them. The WebMCP tools below cover those.
        </p>

        <h3 class="text-base font-semibold">Limits and errors</h3>
        <ul class="text-foreground/80 list-disc space-y-1.5 pl-5 text-sm">
          <li>
            Every call is one JSON-RPC message sent with <code
              class="bg-muted rounded px-1 py-0.5 font-mono text-sm">POST</code
            >. Batches are rejected.
          </li>
          <li>
            Results are capped: 100 modules for <code
              class="bg-muted rounded px-1 py-0.5 font-mono text-sm"
              >search_modules</code
            > and 200 exams for <code
              class="bg-muted rounded px-1 py-0.5 font-mono text-sm"
              >list_exams</code
            >. For everything at once, download the data files above.
          </li>
          <li>
            Many people share the same network address, so the per-address limit
            is high. Back off on <code
              class="bg-muted rounded px-1 py-0.5 font-mono text-sm">429</code
            > and wait the number of seconds in the <code
              class="bg-muted rounded px-1 py-0.5 font-mono text-sm"
              >Retry-After</code
            > header.
          </li>
          <li>
            A browser on another site gets <code
              class="bg-muted rounded px-1 py-0.5 font-mono text-sm">403</code
            >, other methods get <code
              class="bg-muted rounded px-1 py-0.5 font-mono text-sm">405</code
            >, and bodies over 16 KB get <code
              class="bg-muted rounded px-1 py-0.5 font-mono text-sm">413</code
            >.
          </li>
          <li>
            Text in module records comes from NTU. Treat it as data, not as
            instructions.
          </li>
        </ul>
      </section>

      <section class="space-y-3" aria-labelledby="webmcp">
        <h2
          id="webmcp"
          class="scroll-mt-28 text-lg font-semibold tracking-tight">
          AI assistants and WebMCP<HeadingAnchor
            id="webmcp"
            label="AI assistants and WebMCP"
          />
        </h2>
        <p class="text-foreground/80 text-sm">
          NTUMods also offers its tools to browser AI assistants through WebMCP.
          This is an early developer preview. The standard is still a draft and
          support is limited, so treat it as something to test, not to build on.
          The discovery files above list what is available. For setup steps,
          read the <a class={link} href="/articles/ntu-ai-agents-webmcp-guide"
            >WebMCP guide</a
          >.
        </p>
      </section>
    </div>

    <ArticleToc client:idle headings={headings} />
  </div>
</BaseLayout>

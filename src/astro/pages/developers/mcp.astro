---
import { ChevronRight } from "lucide-react"

import { siteConfig } from "@/config/site"
import { MCP_CLIENTS } from "@/lib/developers/mcp-clients"
import { directoryListings, mcpUrl } from "@/lib/developers/mcp-docs"
import { cardVariants } from "@/components/ui/card"
import { ExternalLinkIcon } from "@/components/ui/text-link"
import { CLAUDE_COLOUR, ClaudeIcon, OpenAIIcon } from "@/components/brand-icons"
import HeadingAnchor from "@/components/heading-anchor"
import DevDocsLayout from "@/astro/layouts/DevDocsLayout.astro"

export const prerender = true

const { title, desc } = siteConfig.metatags.developersMcp
---

<DevDocsLayout
  title={title}
  description={desc}
  path="/developers/mcp"
  eyebrow="MCP"
  heading="MCP server"
  intro="A public, read-only MCP server for NTU modules, class indexes and exams. No sign-in and no key.">
  <div class="flex flex-col gap-4">
    <h2 id="what-is-mcp">
      What is MCP?<HeadingAnchor id="what-is-mcp" label="What is MCP?" />
    </h2>
    <p>
      MCP, the Model Context Protocol, is an open standard that lets an AI
      assistant call tools on a server it does not own. Instead of guessing from
      what it learned in training, the assistant sends a request, the server
      answers with data, and the assistant uses that answer in its reply.
    </p>

    <h2 id="what-for">
      What it is used for<HeadingAnchor
        id="what-for"
        label="What it is used for"
      />
    </h2>
    <p>
      NTUMods runs a read-only MCP server at <code>{mcpUrl}</code>. Once you add
      it, your assistant can look up modules, class indexes and exams in the
      real NTU data instead of guessing: what a module needs as a prerequisite,
      which indexes it has and when they run, and when the exam is. It serves
      the same data as the <a href="/developers/api">REST API and data files</a
      >, and needs no sign-in or key. Use the API or the data files in your own
      code, and the MCP server when you want an AI assistant to ask the
      questions.
    </p>
    <p>
      Ready to use it? Go to <a href="#connect">Connect</a>, or pick your
      assistant under <strong>Adding to</strong> in the side menu.
    </p>

    <h2 id="connect">
      Connect<HeadingAnchor id="connect" label="Connect" />
    </h2>
    <p>
      Use Claude or ChatGPT? Install the official NTUMods connector in one
      click:
    </p>
    <div class="grid gap-3 sm:grid-cols-2">
      {
        directoryListings.map((l) => {
          const card = "bg-muted flex flex-col gap-3 rounded-2xl p-5 text-left"
          const body = (
            <>
              <div class="flex items-start justify-between">
                {l.name === "Claude" ? (
                  <ClaudeIcon
                    className="size-7"
                    style={{ color: CLAUDE_COLOUR }}
                  />
                ) : (
                  <OpenAIIcon className="size-7" />
                )}
                {l.url && <ExternalLinkIcon className="size-5" />}
              </div>
              <div class="space-y-1">
                <p class="text-base font-semibold">Add to {l.name}</p>
                <p class="text-muted-foreground text-sm">
                  {l.url
                    ? `Install the official NTUMods connector in ${l.name}.`
                    : `The ${l.name} connector is coming soon. Use the steps below until then.`}
                </p>
              </div>
              <p class="text-muted-foreground text-sm">
                {l.url ? `Open in ${l.name}` : "Coming soon"}
              </p>
            </>
          )
          return l.url ? (
            <a
              class={`${card} hover:bg-accent transition-colors`}
              href={l.url}
              target="_blank"
              rel="noopener">
              {body}
            </a>
          ) : (
            <div class={card} aria-disabled="true">
              {body}
            </div>
          )
        })
      }
    </div>
    <p>Use another assistant, or add it by hand? Each one has its own steps:</p>
    <div class="grid gap-3 sm:grid-cols-2">
      {
        MCP_CLIENTS.map((c) => (
          <a
            class:list={[
              cardVariants({ interactive: true }),
              "flex items-center justify-between p-4"
            ]}
            href={`/developers/mcp/${c.id}`}>
            <span class="text-sm font-semibold">{c.label}</span>
            <ChevronRight className="text-muted-foreground size-4 shrink-0" />
          </a>
        ))
      }
    </div>
    <p>
      Want to know what your assistant can ask? See the <a
        href="/developers/mcp/tools">MCP tools</a
      > and the <a href="/developers/mcp/limits">limits and errors</a>.
    </p>
  </div>
</DevDocsLayout>

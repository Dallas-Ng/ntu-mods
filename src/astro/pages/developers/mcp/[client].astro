---
import { siteConfig } from "@/config/site"
import { MCP_CLIENTS } from "@/lib/developers/mcp-clients"
import {
  claudeCodeCommand,
  claudeCodeUserCommand,
  codexCommand,
  codexToml,
  cursorConfig,
  mcpRemoteCommand,
  mcpUrl,
  vscodeConfig
} from "@/lib/developers/mcp-docs"
import McpClientSteps from "@/components/developers/mcp-client-steps"
import DevDocsLayout from "@/astro/layouts/DevDocsLayout.astro"

export const prerender = true

export function getStaticPaths() {
  return MCP_CLIENTS.map((client) => ({
    params: { client: client.id },
    props: { client }
  }))
}

const { client } = Astro.props
const title = `Add NTUMods to ${client.label}`
---

<DevDocsLayout
  title={title}
  description={`How to add the NTUMods MCP server to ${client.label}, step by step.`}
  path={`/developers/mcp/${client.id}`}
  eyebrow="Adding to"
  heading={client.label}
  intro={`Step by step. The server is ${mcpUrl}, with no sign-in and no key.`}>
  <div class="flex flex-col gap-6">
    <McpClientSteps
      client:load
      id={client.id}
      mcpUrl={mcpUrl}
      directoryUrl={siteConfig.links.claudeDirectory}
      claudeCodeCommand={claudeCodeCommand}
      claudeCodeUserCommand={claudeCodeUserCommand}
      codexCommand={codexCommand}
      codexToml={codexToml}
      cursorConfig={cursorConfig}
      vscodeConfig={vscodeConfig}
      mcpRemoteCommand={mcpRemoteCommand}
    />
    <p>
      Next, see what your assistant can ask in the <a
        href="/developers/mcp/tools">MCP tools</a
      >, the <a href="/developers/mcp/limits">limits and errors</a>, or go back
      to the <a href="/developers/mcp">MCP server</a> overview.
    </p>
  </div>
</DevDocsLayout>

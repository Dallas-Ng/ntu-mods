---
import { siteConfig } from "@/config/site"
import { datasetJsonLd } from "@/lib/json-ld"
import { getExamModuleUrl } from "@/lib/module-url"
import {
  getAllModuleCodes,
  getCurrentYearExamSemesters,
  getSemesterExamsData
} from "@/lib/server/db/repo"
import { buttonVariants } from "@/components/ui/button"
import { cardVariants } from "@/components/ui/card"
import { LinkArrow } from "@/components/ui/text-link"
import ExamsList, { type ListedExam } from "@/components/exams/exams-list"
import Header from "@/components/header"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const LAST_UPDATED = "18 November 2026"

// Every semester with exams in the newest academic year is listed together,
// so semester 1 exams still running stay visible once semester 2 is released.
// NTU sometimes lists an exam for a module it never loaded, so it has no page.
const pageUrls = new Set((await getAllModuleCodes()).map((c) => `/mods/${c}`))
const semesters = await getCurrentYearExamSemesters()
const parts = await Promise.all(
  semesters.map(async ({ year, semester }) => {
    const short =
      semester === "1" || semester === "2" ? `S${semester}` : semester
    const label = `AY${year} ${short}`
    const exams = Object.values(await getSemesterExamsData(year, semester))
    return { year, semester, label, exams }
  })
)

const examList: ListedExam[] = parts.flatMap((p) =>
  p.exams.map((e) => ({
    ...e,
    semester: p.label,
    hasPage: pageUrls.has(getExamModuleUrl(e.key))
  }))
)
const total = examList.length

const termName = (semester: string) =>
  semester === "S" || semester === "T" ? "Special Term" : `Semester ${semester}`
const label =
  parts.length === 0
    ? ""
    : `AY${parts[0].year} ${parts.map((p) => termName(p.semester)).join(" and ")}`

// Exam dates are "23 November 2026" strings, so sort them as dates.
const sortDates = (list: { date: string }[]) =>
  [...new Set(list.map((e) => e.date))].sort(
    (a, b) => new Date(a).getTime() - new Date(b).getTime()
  )
const fmt = (d: string, year = false) =>
  new Date(d).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    ...(year && { year: "numeric" })
  })
const periodOf = (list: { date: string }[]) => {
  const dates = sortDates(list)
  return dates.length > 0
    ? `${fmt(dates[0])} to ${fmt(dates[dates.length - 1], true)}`
    : "TBC"
}
const facts = parts.map((p) => ({
  label: `${p.label} exam period`,
  period: periodOf(p.exams),
  modules: new Set(p.exams.map((e) => e.key)).size,
  exams: p.exams.length
}))
---

<BaseLayout
  title={`NTU Exam Schedule ${label}`}
  description={`Browse ${total} NTU exams for ${label}. Search by module code or name, and check exam dates, times, and durations.`}
  canonical="/exams"
  ogImage={`${siteConfig.url}/og/exams.png`}
  ogImageAlt="NTUMods exam schedule listing NTU exam dates and times for SC modules"
  size="md"
  containerClassName="space-y-8">
  <JsonLd
    data={datasetJsonLd({
      name: `NTU Exam Schedule ${label}`,
      description: `${total} NTU exams for ${label}: module code, name, date, start and end time.`,
      path: "/exams",
      keywords: ["NTU", "exam schedule", "exam timetable", label],
      dateModified: new Date(`${LAST_UPDATED} UTC`).toISOString().slice(0, 10)
    })}
  />
  <Header
    title="NTU exam schedule"
    subtitle={total > 0
      ? `Final exam dates, times and durations for ${label}, from NTU's official timetable.`
      : "No exam data available yet."}
  />

  <div
    class:list={[
      cardVariants(),
      "flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"
    ]}>
    <div class="min-w-0 space-y-1">
      <p class="text-xl font-bold tracking-tight">Find your exam dates</p>
      <p class="text-muted-foreground text-sm text-pretty">
        Check when and where you sit each paper, and what to bring on the day.
      </p>
    </div>
    <a
      href="/articles/ntu-exam-schedule-ay2026"
      class={buttonVariants({ size: "lg", className: "group shrink-0" })}>
      Read the guide
      <LinkArrow />
    </a>
  </div>

  <div class="grid gap-x-0 gap-y-6 md:grid-cols-2">
    {
      facts.map(({ label, period, modules, exams }, i) => (
        <dl class:list={["space-y-3", i > 0 && "md:border-l md:pl-6"]}>
          <div class="space-y-1">
            <dt class="text-muted-foreground text-sm whitespace-nowrap">
              {label}
            </dt>
            <dd class="text-xl font-bold tracking-tight whitespace-nowrap md:text-2xl md:tracking-tighter">
              {period}
            </dd>
          </div>
          <div class="flex gap-10">
            <div class="space-y-1">
              <dt class="text-muted-foreground text-sm">Modules</dt>
              <dd class="text-xl font-bold tracking-tight">{modules}</dd>
            </div>
            <div class="space-y-1">
              <dt class="text-muted-foreground text-sm">Exams</dt>
              <dd class="text-xl font-bold tracking-tight">{exams}</dd>
            </div>
          </div>
        </dl>
      ))
    }
  </div>

  <ExamsList client:load exams={examList} />
</BaseLayout>

---
import { ArrowRight } from "lucide-react"

import { siteConfig } from "@/config/site"
import { datasetJsonLd } from "@/lib/json-ld"
import {
  getLatestExamSemester,
  getSemesterExamsData
} from "@/lib/server/db/repo"
import { cardVariants } from "@/components/ui/card"
import ExamsList from "@/components/exams/exams-list"
import Header from "@/components/header"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const LAST_UPDATED = "27 July 2026"

// Previously: read the latest semester, and if it had no exams, walk the
// portal's semester list backwards until one did. That is a single indexed
// query — the newest semester that actually has exam rows.
async function getExamData() {
  const latest = await getLatestExamSemester()
  if (!latest) return { exams: {}, label: "" }

  const isSpecial = latest.semester === "S" || latest.semester === "T"
  return {
    exams: await getSemesterExamsData(latest.year, latest.semester),
    label: isSpecial
      ? `AY${latest.year} Special Term`
      : `AY${latest.year} Semester ${latest.semester}`
  }
}

const { exams, label } = await getExamData()
const examList = Object.values(exams)
const total = examList.length

// Exam dates are "23 November 2026" strings, so sort them as dates.
const dates = [...new Set(examList.map((e) => e.date))].sort(
  (a, b) => new Date(a).getTime() - new Date(b).getTime()
)
const fmt = (d: string, year = false) =>
  new Date(d).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    ...(year && { year: "numeric" })
  })
const period =
  dates.length > 0
    ? `${fmt(dates[0])} to ${fmt(dates[dates.length - 1], true)}`
    : "TBC"
const updated = new Date(`${LAST_UPDATED} UTC`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC"
})
const facts = [
  { label: "Exam period", value: period, wide: true },
  { label: "Modules", value: String(total) },
  { label: "Exam days", value: String(dates.length) },
  { label: "Last updated", value: updated }
]
---

<BaseLayout
  title={`NTU Exam Schedule ${label}`}
  description={`Browse ${total} NTU exams for ${label}. Search by module code or name, and check exam dates, times, and durations.`}
  canonical="/exams"
  ogImage={`${siteConfig.url}/og/exams.png`}
  ogImageAlt="NTUMods exam schedule listing NTU exam dates and times for SC modules"
  size="md"
  containerClassName="space-y-6">
  <JsonLd
    data={datasetJsonLd({
      name: `NTU Exam Schedule ${label}`,
      description: `${total} NTU exams for ${label}: module code, name, date, start and end time.`,
      path: "/exams",
      keywords: ["NTU", "exam schedule", "exam timetable", label],
      dateModified: new Date(`${LAST_UPDATED} UTC`).toISOString().slice(0, 10)
    })}
  />
  <Header
    title="NTU Exam Schedule"
    subtitle={total > 0
      ? `Final exam dates, times and durations for ${label}, from NTU's official timetable.`
      : `No exam data available for ${label}`}
  />

  <div
    class:list={[
      cardVariants(),
      "flex flex-col gap-4 rounded-2xl p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"
    ]}>
    <div class="min-w-0 space-y-1">
      <p class="text-xl font-bold tracking-tight">Find your exam dates</p>
      <p class="text-muted-foreground text-sm text-pretty">
        Check when and where you sit each paper, and what to bring on the day.
      </p>
    </div>
    <a
      href="/articles/ntu-exam-schedule-ay2026"
      class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-full px-5 text-sm font-medium whitespace-nowrap transition-colors">
      Read the guide
      <ArrowRight class="size-4" />
    </a>
  </div>

  <dl class="grid grid-cols-6 gap-x-4 gap-y-5 md:grid-cols-4 md:gap-x-0">
    {
      facts.map(({ label, value, wide }, i) => (
        <div
          class:list={[
            "space-y-1 md:col-span-1",
            wide ? "col-span-6" : "col-span-2",
            i > 0 && "md:border-l md:pl-6"
          ]}>
          <dt class="text-muted-foreground text-sm whitespace-nowrap">
            {label}
          </dt>
          <dd class="text-xl font-bold tracking-tight whitespace-nowrap md:text-2xl md:tracking-tighter">
            {value}
          </dd>
        </div>
      ))
    }
  </dl>

  <ExamsList client:load exams={examList} />
</BaseLayout>

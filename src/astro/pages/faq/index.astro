---
import { siteConfig } from "@/config/site"
import { faqPageJsonLd } from "@/lib/json-ld"
import ArticleToc from "@/components/articles/article-toc"
import FaqContent, { faqHeadings, faqItems } from "@/components/faq/faq-content"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true
---

<BaseLayout
  title={siteConfig.metatags.faq.title}
  description={siteConfig.metatags.faq.desc}
  canonical="/faq">
  <FaqContent>
    <ArticleToc client:idle headings={faqHeadings} />
  </FaqContent>
  <JsonLd data={faqPageJsonLd(faqItems)} />
</BaseLayout>

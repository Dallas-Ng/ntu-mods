---
import { siteConfig } from "@/config/site"
import { webPageJsonLd } from "@/lib/json-ld"
import FeedbackCard from "@/components/feedback-card"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const jsonLd = webPageJsonLd({
  name: siteConfig.metatags.feedback.title,
  description: siteConfig.metatags.feedback.desc,
  path: "/feedback",
  type: "ContactPage"
})
---

<BaseLayout
  title={siteConfig.metatags.feedback.title}
  description={siteConfig.metatags.feedback.desc}
  canonical="/feedback"
  containerClassName="max-w-full p-0 lg:px-0">
  <JsonLd data={jsonLd} />
  <div
    class="mx-auto grid max-w-7xl gap-10 px-4 pt-8 pb-12 md:pt-10 md:pb-20 lg:grid-cols-[5fr_6fr] lg:items-start lg:gap-12 [&>*]:min-w-0">
    <div>
      <h1
        class="text-3xl leading-[1.05] font-bold tracking-tighter md:text-5xl">
        Tell us what to fix
      </h1>
      <p class="mt-4 max-w-xl text-base md:text-lg">
        Share your thoughts, report issues, or suggest improvements.
      </p>
      <div
        class="text-foreground/80 mt-6 max-w-xl space-y-4 text-base md:text-lg">
        <p>
          NTUMods is built and maintained by a single person. There is no team,
          just one developer juggling updates, data refreshes, and new features
          alongside everything else.
        </p>
        <p>
          If something is broken, confusing, or could be better, I genuinely
          want to hear about it. Feedback and improvement ideas go a long way in
          keeping this project alive and useful.
        </p>
      </div>
      <a
        href="/faq"
        class="text-primary mt-6 inline-block text-lg font-semibold underline-offset-4 hover:underline">
        Read the FAQ first
      </a>
    </div>

    <FeedbackCard client:idle />
  </div>
</BaseLayout>

---
import { GitPullRequest } from "lucide-react"

import { siteConfig } from "@/config/site"
import { webPageJsonLd } from "@/lib/json-ld"
import FeedbackCard from "@/components/feedback-card"
import Header from "@/components/header"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const jsonLd = webPageJsonLd({
  name: siteConfig.metatags.feedback.title,
  description: siteConfig.metatags.feedback.desc,
  path: "/feedback",
  type: "ContactPage"
})
---

<BaseLayout
  title={siteConfig.metatags.feedback.title}
  description={siteConfig.metatags.feedback.desc}
  canonical="/feedback"
  size="sm"
  containerClassName="space-y-8">
  <JsonLd data={jsonLd} />
  <Header
    title="Feedback"
    subtitle="Share your thoughts, report issues, or suggest improvements."
  />

  <div class="text-muted-foreground space-y-2 text-sm leading-relaxed">
    <p>
      NTUMods is built and maintained by a single person. There is no team, just
      one developer juggling updates, data refreshes, and new features alongside
      everything else.
    </p>
    <p>
      If something is broken, confusing, or could be better, I genuinely want to
      hear about it. Feedback and improvement ideas go a long way in keeping
      this project alive and useful. Check the{" "}
      <a
        href="/faq"
        class="text-primary hover:text-primary/80 underline underline-offset-2 transition-colors">
        FAQ
      </a>{" "}
      first in case your question is already answered.
    </p>
  </div>

  <div
    class="bg-muted/50 flex items-start gap-3 rounded-2xl p-4 text-sm leading-relaxed">
    <GitPullRequest class="text-muted-foreground mt-0.5 size-4 shrink-0" />
    <div class="space-y-0.5 text-pretty">
      <p class="font-medium">Developer?</p>
      <p class="text-muted-foreground">
        Open an{" "}
        <a
          href={`${siteConfig.links.repo}/issues`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:text-primary/80 underline underline-offset-2 transition-colors">
          issue
        </a>{" "}
        or send a pull request on GitHub. See the{" "}
        <a
          href={`${siteConfig.links.repo}/blob/main/CONTRIBUTING.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:text-primary/80 underline underline-offset-2 transition-colors">
          contributing guide
        </a>
        .
      </p>
    </div>
  </div>

  <FeedbackCard client:idle />
</BaseLayout>

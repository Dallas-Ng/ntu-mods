---
import { siteConfig } from "@/config/site"
import { organizationJsonLd, websiteJsonLd } from "@/lib/json-ld"
import { LATEST_SEMESTER_LABEL } from "@/lib/semesters"
import { getLatestSemester } from "@/lib/server/db/repo"
import LandingActivity from "@/components/landing/landing-activity"
import LandingArticles from "@/components/landing/landing-articles"
import LandingCTA from "@/components/landing/landing-cta"
import LandingDemo from "@/components/landing/landing-demo"
import LandingFeatures from "@/components/landing/landing-features"
import LandingShowcase from "@/components/landing/landing-showcase"
import LandingStats from "@/components/landing/landing-stats"
import { getSemesterStats } from "@/components/landing/landing-stats-data"
import LandingTools from "@/components/landing/landing-tools"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const { year, semester } = await getLatestSemester()
const stats = await getSemesterStats(year, semester)
---

<BaseLayout
  title="NTUMods | NTU Timetable Planner and Module Finder"
  description={siteConfig.metatags.default.desc}
  canonical="/"
  containerClassName="max-w-full p-0 lg:px-0">
  <div
    class="mx-auto grid max-w-7xl gap-10 px-4 pt-8 pb-8 md:pt-10 xl:grid-cols-[5fr_6fr] xl:items-center xl:gap-12 [&>*]:min-w-0">
    <LandingCTA semesterLabel={LATEST_SEMESTER_LABEL} />
    <LandingShowcase client:idle />
  </div>

  <div class="mt-6 md:mt-10">
    <LandingStats semesterLabel={LATEST_SEMESTER_LABEL} stats={stats} />
  </div>

  <div class="mt-24 md:mt-36">
    <LandingFeatures client:visible />
    <div class="mt-24 md:mt-36">
      <LandingTools />
    </div>
    <div class="mt-24 md:mt-36">
      <LandingArticles />
    </div>
    <div class="mt-24 md:mt-36">
      <LandingActivity />
    </div>
  </div>

  <section class="mx-auto mt-24 mb-12 max-w-7xl px-4 md:mt-36 md:mb-20">
    <h2
      class="landing-reveal mb-10 max-w-3xl text-3xl leading-none font-bold tracking-tighter md:text-4xl">
      See a week for every course
    </h2>
    <LandingDemo client:visible={{ rootMargin: "1200px" }} />
    <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
      <a
        href="/timetable"
        class="bg-primary text-primary-foreground inline-flex h-12 items-center justify-center rounded-md px-6 text-sm font-semibold transition-transform md:px-8">
        Build my timetable
      </a>
      <a
        href="/mods"
        class="bg-secondary hover:bg-secondary/80 inline-flex h-12 items-center justify-center rounded-md px-6 text-sm font-semibold transition-colors md:px-8">
        Browse modules
      </a>
    </div>
  </section>

  <JsonLd data={[websiteJsonLd(), organizationJsonLd()]} />
</BaseLayout>

<style is:global>
  @keyframes landing-ring {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .landing-ring {
      animation: landing-ring var(--ring-ms) linear forwards;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .landing-reveal {
        animation: landing-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 35%;
      }
      @keyframes landing-rise {
        from {
          opacity: 0;
          transform: translateY(32px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
    }
  }
</style>

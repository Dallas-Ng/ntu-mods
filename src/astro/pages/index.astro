---
import { siteConfig } from "@/config/site"
import LandingArticles from "@/components/landing/landing-articles"
import LandingCTA from "@/components/landing/landing-cta"
import LandingFeatures from "@/components/landing/landing-features"
import LandingProduct from "@/components/landing/landing-product"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.name,
  url: siteConfig.url,
  logo: `${siteConfig.url}/logo.png`,
  description:
    "Free, independent timetable planner and module browser for Nanyang Technological University students. Not affiliated with NTU."
}

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.url,
  description:
    "NTU timetable planner and module browser for Nanyang Technological University students.",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteConfig.url}/mods?searchTerm={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
}
---

<BaseLayout
  title="NTUMods | NTU Timetable Planner and Module Finder"
  description="Plan NTU timetables, browse modules, compare indexes, check exams, share schedules, and export calendars or wallpapers in one course planning tool."
  canonical="/"
  containerClassName="max-w-full p-0 lg:px-0">
  <div class="relative z-[3] space-y-10 p-3">
    <LandingCTA />
  </div>

  <div class="relative overflow-hidden">
    <div class="relative z-[2] container p-3">
      <LandingProduct />
    </div>

    {
      /* CSS backgrounds, not <img>: crawlers/AI previews pick <img> as the page thumbnail */
    }
    <div
      aria-hidden="true"
      class="absolute bottom-1/2 left-0 z-[1] hidden aspect-[3/2] w-full bg-[url('/landing/product-bg.svg')] bg-cover lg:block">
    </div>
    <div
      aria-hidden="true"
      class="absolute top-1/2 z-[1] hidden aspect-[3/2] w-full rotate-180 bg-[url('/landing/product-bg.svg')] bg-cover lg:block">
    </div>
  </div>

  <div class="relative z-[3] mt-10 space-y-10 p-3">
    <LandingFeatures />

    <div class="xl:container xl:py-20">
      <LandingArticles />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(organizationJsonLd)}
  />
</BaseLayout>

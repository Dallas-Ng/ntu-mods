---
import { siteConfig } from "@/config/site"
import { formatCount } from "@/lib/format"
import { organizationJsonLd, websiteJsonLd } from "@/lib/json-ld"
import { LATEST_SEMESTER_LABEL } from "@/lib/semesters"
import { getLatestSemester, getSemesterCounts } from "@/lib/server/db/repo"
import LandingArticles from "@/components/landing/landing-articles"
import LandingCTA from "@/components/landing/landing-cta"
import LandingFeatures from "@/components/landing/landing-features"
import LandingProduct from "@/components/landing/landing-product"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const { year, semester } = await getLatestSemester()
const counts = await getSemesterCounts(year, semester)
---

<BaseLayout
  title="NTUMods | NTU Timetable Planner and Module Finder"
  description={siteConfig.metatags.default.desc}
  canonical="/"
  containerClassName="max-w-full p-0 lg:px-0">
  <div class="relative z-[3] space-y-10 p-3">
    <LandingCTA
      semesterLabel={LATEST_SEMESTER_LABEL}
      modules={formatCount(counts.modules)}
      indexes={formatCount(counts.indexes)}
    />
  </div>

  <div class="relative overflow-hidden">
    <div class="relative z-[2] container p-3">
      <LandingProduct />
    </div>

    {
      /* CSS backgrounds, not <img>: crawlers/AI previews pick <img> as the page thumbnail */
    }
    <div
      aria-hidden="true"
      class="absolute bottom-1/2 left-0 z-[1] hidden aspect-[3/2] w-full bg-[url('/landing/product-bg.svg')] bg-cover lg:block">
    </div>
    <div
      aria-hidden="true"
      class="absolute top-1/2 z-[1] hidden aspect-[3/2] w-full rotate-180 bg-[url('/landing/product-bg.svg')] bg-cover lg:block">
    </div>
  </div>

  <div class="relative z-[3] mt-10 space-y-10 p-3">
    <LandingFeatures />

    <div class="xl:container xl:py-20">
      <LandingArticles />
    </div>
  </div>

  <JsonLd data={[websiteJsonLd(), organizationJsonLd()]} />
</BaseLayout>

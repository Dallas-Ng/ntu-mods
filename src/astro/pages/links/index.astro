---
import { siteConfig } from "@/config/site"
import { collectionPageJsonLd } from "@/lib/json-ld"
import ArticleToc from "@/components/articles/article-toc"
import LinksContent, { linkHeadings } from "@/components/links/links-content"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const linksJsonLd = collectionPageJsonLd({
  name: siteConfig.metatags.studentLinks.title,
  description: siteConfig.metatags.studentLinks.desc,
  path: "/links",
  items: linkHeadings.map(({ id, text }) => ({
    name: text,
    url: `${siteConfig.url}/links#${id}`
  }))
})
---

<BaseLayout
  title={siteConfig.metatags.studentLinks.title}
  description={siteConfig.metatags.studentLinks.desc}
  canonical="/links"
  ogImage={`${siteConfig.url}/og/links.png`}
  ogImageAlt="NTUMods student links: STARS, NTULearn, Degree Audit and other NTU portals">
  <JsonLd data={linksJsonLd} />
  <LinksContent client:idle>
    <ArticleToc client:idle headings={linkHeadings} />
  </LinksContent>
</BaseLayout>

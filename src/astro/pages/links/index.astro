---
import { siteConfig } from "@/config/site"
import ArticleToc from "@/components/articles/article-toc"
import LinksContent, { linkHeadings } from "@/components/links/links-content"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true
---

<BaseLayout
  title={siteConfig.metatags.studentLinks.title}
  description={siteConfig.metatags.studentLinks.desc}
  canonical="/links"
  ogImage={`${siteConfig.url}/og/links.png`}>
  <LinksContent client:idle>
    <ArticleToc client:idle headings={linkHeadings} />
  </LinksContent>
</BaseLayout>

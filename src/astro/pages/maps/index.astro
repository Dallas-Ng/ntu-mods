---
import MapsPageContent from "@/components/map/maps-page-content"
import MapGuide from "@/astro/components/MapGuide.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = false

// Not public yet: only served by `yarn dev` until the map is reviewed.
if (!import.meta.env.DEV) return new Response(null, { status: 404 })

const CREDITS = [
  {
    label: "Buildings and rooms",
    text: "NTU Maps",
    href: "https://maps.ntu.edu.sg/",
    note: "powered by MazeMap"
  },
  {
    label: "Roads and greenery",
    text: "OpenStreetMap contributors",
    href: "https://www.openstreetmap.org/copyright",
    prefix: "© "
  },
  { label: "Satellite imagery", text: "Esri, Maxar, Earthstar Geographics" }
]
---

<BaseLayout
  title="NTU Campus Map"
  description="Find any NTU lecture theatre, tutorial room, hall or canteen, see which level it is on, and get walking directions with times."
  canonical="/maps">
  <MapsPageContent client:load />

  <MapGuide />

  <footer class="text-muted-foreground mt-12 space-y-3 border-t pt-5 text-xs">
    <dl class="grid gap-x-8 gap-y-1.5 sm:grid-cols-[auto_1fr]">
      {
        CREDITS.map(({ label, text, href, note, prefix }) => (
          <>
            <dt class="text-foreground/80 font-medium">{label}</dt>
            <dd>
              {prefix}
              {href ? (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-foreground underline underline-offset-2 transition-colors">
                  {text}
                </a>
              ) : (
                text
              )}
              {note && `, ${note}`}
            </dd>
          </>
        ))
      }
    </dl>
    <p class="leading-relaxed">
      Venues are matched to rooms by name, so a few pins may be approximate.
      Walking times are estimates.
    </p>
  </footer>
</BaseLayout>

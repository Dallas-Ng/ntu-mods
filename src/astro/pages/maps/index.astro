---
import { siteConfig } from "@/config/site"
import { cardVariants } from "@/components/ui/card"
import { CardCta, TextLink } from "@/components/ui/text-link"
import MapsPageContent from "@/components/map/maps-page-content"
import MapGuide from "@/astro/components/MapGuide.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const CREDITS = [
  {
    label: "Buildings and rooms",
    text: "NTU Maps",
    href: "https://maps.ntu.edu.sg/",
    note: "powered by MazeMap"
  },
  {
    label: "Roads and greenery",
    text: "OpenStreetMap contributors",
    href: "https://www.openstreetmap.org/copyright",
    prefix: "© "
  },
  { label: "Satellite imagery", text: "Esri, Maxar, Earthstar Geographics" }
]
---

<BaseLayout
  title="NTU Campus Map"
  description="Find any NTU lecture theatre, tutorial room, hall or canteen, see which level it is on, and get walking directions with times."
  canonical="/maps"
  ogImage={`${siteConfig.url}/og/maps.png`}
  ogImageAlt="NTUMods campus map with North Spine pinned, floor plans and walking directions">
  <MapsPageContent client:load />

  <MapGuide />

  <a
    href="/articles/ntu-campus-map-guide"
    class:list={[
      cardVariants({ interactive: true }),
      "group mx-auto mt-12 flex max-w-3xl flex-col overflow-hidden sm:flex-row"
    ]}>
    <div class="bg-muted sm:w-80 sm:shrink-0">
      <img
        src="/articles/ntu-campus-map-guide/overview.webp"
        alt="The NTUMods campus map with search, category chips and a side panel"
        width="2040"
        height="1038"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-left-top dark:hidden"
      />
      <img
        src="/articles/ntu-campus-map-guide/overview-dark.webp"
        alt="The NTUMods campus map with search, category chips and a side panel"
        width="2040"
        height="1038"
        loading="lazy"
        decoding="async"
        class="hidden h-full w-full object-cover object-left-top dark:block"
      />
    </div>
    <div class="flex flex-col justify-center gap-2 p-5">
      <p class="text-muted-foreground text-xs font-medium">Guide</p>
      <h2 class="text-base leading-snug font-semibold">
        NTU Campus Map: Find Any Lecture Theatre, Room and Walking Route
      </h2>
      <p class="text-muted-foreground text-sm leading-relaxed">
        Never be late to a lecture again. Learn how to find any lecture theatre
        or tutorial room, read NTU room codes, pick the right level and time the
        walk between back-to-back classes, with screenshots of every step.
      </p>
      <CardCta className="mt-1">Read the guide</CardCta>
    </div>
  </a>

  <footer class="text-muted-foreground mt-12 space-y-3 border-t pt-5 text-xs">
    <dl class="grid gap-x-8 gap-y-1.5 sm:grid-cols-[auto_1fr]">
      {
        CREDITS.map(({ label, text, href, note, prefix }) => (
          <>
            <dt class="text-foreground font-medium">{label}</dt>
            <dd>
              {prefix}
              {href ? (
                <TextLink
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  variant="muted">
                  {text}
                </TextLink>
              ) : (
                text
              )}
              {note && `, ${note}`}
            </dd>
          </>
        ))
      }
    </dl>
    <p class="leading-relaxed">
      Venues are matched to rooms by name, so a few pins may be approximate.
      Walking times are estimates.
    </p>
  </footer>
</BaseLayout>

---
import { buildModuleMeta } from "@/lib/module-meta"
import { getModuleUrl } from "@/lib/module-url"
import {
  getActiveModuleCodes,
  getAllModuleMetadata,
  getModuleCurrentSemester,
  getModuleExamData,
  getModuleIndexesData,
  getModulePrerequisites,
  getModuleSemesters,
  getPrerequisiteGraph
} from "@/lib/server/db/repo"
import ModsModulePage from "@/astro/components/ModsModulePage.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

// Fully static — Cloudflare Workers have no runtime filesystem, so this can't
// read module data per-request like it used to. Case-sensitive as a result:
// only the canonical uppercase path is generated, lowercase URLs 404 instead
// of redirecting (same trade-off already accepted for the versioned module
// snapshot pages).
export const prerender = true

// Only the active/latest semester's ~1,100 codes are built statically — the
// other ~3,200 codes ever offered render on demand instead (404.astro +
// getLatestModuleSnapshot), since prerendering all of them dominated build
// time for pages almost nobody visits. Because every code here is by
// definition offered in the latest semester, isCurrentOffering below is
// always true for statically built pages.
export async function getStaticPaths() {
  return (await getActiveModuleCodes()).map((code) => ({
    params: { module: code }
  }))
}

const moduleKey = Astro.params.module ?? ""

const current = await getModuleCurrentSemester(moduleKey)
if (!current) return new Response(null, { status: 404 })

const { year, semester } = current

const [allMeta, indexes, exam, prereqGraph, prereqNode, allSemesters] =
  await Promise.all([
    getAllModuleMetadata(year, semester),
    getModuleIndexesData(moduleKey, year, semester),
    getModuleExamData(moduleKey, year, semester),
    getPrerequisiteGraph(),
    getModulePrerequisites(moduleKey),
    getModuleSemesters(moduleKey)
  ])

const moduleData = allMeta[moduleKey]
if (!moduleData) return new Response(null, { status: 404 })

// Codes emitted by getStaticPaths are always the current offering of the
// active semester, so this is always true here — kept as a real comparison
// (not hardcoded) so the component stays identical to the on-demand path.
const isCurrentOffering = true

const otherSemesters = allSemesters.filter(
  (s) => !(s.year === year && s.semester === semester)
)

const prefix = moduleKey.slice(0, 2)
const related = Object.values(allMeta)
  .filter((m) => m.code.slice(0, 2) === prefix && m.code !== moduleKey)
  .sort((a, b) => parseInt(a.code.slice(2)) - parseInt(b.code.slice(2)))
  .slice(0, 9)
  .map((m) => ({ code: m.code, title: m.title }))

const { title, description } = buildModuleMeta(moduleKey, moduleData)
---

<BaseLayout
  title={title}
  description={description}
  canonical={getModuleUrl(moduleKey)}
  noTitleSuffix>
  <ModsModulePage
    moduleKey={moduleKey}
    moduleData={moduleData}
    year={year}
    semester={semester}
    indexes={indexes}
    exam={exam}
    isCurrentOffering={isCurrentOffering}
    otherSemesters={otherSemesters}
    prereqGraph={prereqGraph}
    prereqNode={prereqNode}
    related={related}
  />
</BaseLayout>

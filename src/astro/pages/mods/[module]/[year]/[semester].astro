---
import { MODULE_CATEGORY } from "@/lib/constants"
import { formatTitle } from "@/lib/format"
import { breadcrumbListJsonLd } from "@/lib/json-ld"
import { getModuleUrl, getModuleVersionUrl } from "@/lib/module-url"
import { getModuleSnapshot } from "@/lib/server/edge/get-module-snapshot"
import Breadcrumbs from "@/components/breadcrumbs"
import ModsIndexTable from "@/components/mods/mods-index-table"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

// On-demand — Cloudflare Workers has no filesystem at all, even at build
// time by default, so this can't stay in the "prerender everything" model
// the module-level page uses. There are 28,000+ module/year/semester
// combinations; prerendering all of them dominated build time (~18 of a
// ~30 min build) for pages almost nobody visits. Data comes from the ASSETS
// binding (same JSON files, fetched over HTTP instead of node:fs) rather
// than the fs-based src/lib/server/*.ts readers used by prerendered routes.
// Cache-Control lets Cloudflare's edge cache the rendered response after the
// first hit, so repeat visits (especially to the current semester, by far
// the most-visited) don't re-render each time.
export const prerender = false

const {
  module: code,
  year,
  semester
} = Astro.params as {
  module: string
  year: string
  semester: string
}

const snapshot = await getModuleSnapshot(Astro.url, code, year, semester)
// Renders the real 404 page rather than a blank body — /404 is on-demand for
// exactly this reason.
if (!snapshot) return Astro.rewrite("/404")

const { moduleData, indexes, exam, isCurrentOffering, isLatestOffering } =
  snapshot

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=3600, s-maxage=86400"
)

// Precomputed at load, so this route no longer parses programme codes per
// request — it was the last per-request use of getModuleCategories.
const categories = moduleData.categories ?? []

const semName = semester === "S" ? "Special Term" : `Semester ${semester}`
const semLabel = `AY${year}/${parseInt(year) + 1} ${semName}`
const crumbs = [
  { name: "Mods", label: "Mods", href: "/mods" },
  { name: code, label: code, href: getModuleUrl(code) },
  {
    name: semLabel,
    label: semLabel,
    href: getModuleVersionUrl(code, year, semester)
  }
]
---

<BaseLayout
  title={`${code} ${moduleData.title} | AY${year} ${semName}`}
  description={`View the AY${year}/${parseInt(year) + 1} ${semName} record for ${code} ${moduleData.title}, including module details, index schedules, class times, venues, and exams.`}
  canonical={isLatestOffering
    ? getModuleUrl(code)
    : getModuleVersionUrl(code, year, semester)}
  noTitleSuffix>
  <JsonLd data={breadcrumbListJsonLd(crumbs)} />
  {
    !isCurrentOffering && (
      <div class="rounded-md border border-amber-300 bg-amber-50 px-4 py-2 text-sm text-amber-800 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-300">
        Historical snapshot — {semLabel} ·{" "}
        <a
          href={getModuleUrl(code)}
          class="underline transition-colors hover:text-amber-600 dark:hover:text-amber-200">
          View current offering →
        </a>
      </div>
    )
  }

  <div class="mt-4 flex flex-col gap-6 xl:flex-row">
    <div class="w-full xl:w-3/6">
      <Breadcrumbs breadcrumbs={crumbs} />
      <h1 class="mt-2 text-3xl">{formatTitle(moduleData.title)}</h1>
      <p class="text-muted-foreground mt-1 text-sm">{semLabel}</p>
      {
        moduleData.description && (
          <p class="text-muted-foreground mt-4 text-sm leading-relaxed">
            {moduleData.description}
          </p>
        )
      }
    </div>

    <div class="h-fit w-full xl:w-3/6">
      <table class="data-table">
        <tbody>
          <tr>
            <td>AUs</td>
            <td>{moduleData.au} AUs</td>
          </tr>

          {
            categories.length > 0 && (
              <tr>
                <td>Categories</td>
                <td>
                  <div class="flex flex-wrap gap-1">
                    {categories.map((cat) => (
                      <span class="rounded-full border px-2 py-0 text-xs">
                        {MODULE_CATEGORY[cat]}
                      </span>
                    ))}
                  </div>
                </td>
              </tr>
            )
          }

          {
            moduleData.gradeType && (
              <tr>
                <td>Grade Type</td>
                <td>{moduleData.gradeType}</td>
              </tr>
            )
          }

          {
            moduleData.notAvailableToProgramme && (
              <tr>
                <td>Not Available To Programme</td>
                <td>{moduleData.notAvailableToProgramme}</td>
              </tr>
            )
          }

          {
            moduleData.notAvailableToAllProgrammeWith && (
              <tr>
                <td>Not Available To All Programme With</td>
                <td>{moduleData.notAvailableToAllProgrammeWith}</td>
              </tr>
            )
          }

          {
            moduleData.notAvailableAsBdeueToProgramme && (
              <tr>
                <td>Not Available As BDE/UE To Programme</td>
                <td>{moduleData.notAvailableAsBdeueToProgramme}</td>
              </tr>
            )
          }

          {
            moduleData.notAvailableAsCoreToProgramme && (
              <tr>
                <td>Not Available As Core To Programme</td>
                <td>{moduleData.notAvailableAsCoreToProgramme}</td>
              </tr>
            )
          }

          {
            moduleData.notAvailableAsPeToProgramme && (
              <tr>
                <td>Not Available As PE To Programme</td>
                <td>{moduleData.notAvailableAsPeToProgramme}</td>
              </tr>
            )
          }

          {
            moduleData.mutuallyExclusiveWith && (
              <tr>
                <td>Mutually Exclusive With</td>
                <td>{moduleData.mutuallyExclusiveWith.join(", ")}</td>
              </tr>
            )
          }

          {
            moduleData.extras &&
              Object.entries(moduleData.extras).map(([label, value]) => (
                <tr>
                  <td>{label}</td>
                  <td>{value}</td>
                </tr>
              ))
          }

          <tr>
            <td>Exam</td>
            <td>
              {
                exam
                  ? `${exam.date}, ${exam.start_time} - ${exam.end_time}`
                  : ""
              }
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-10 space-y-2">
    <h2 class="text-lg">Available Indexes</h2>
    <ModsIndexTable indexes={indexes} />
  </div>
</BaseLayout>

---
import { readFile } from "node:fs/promises"

import type { AllModule } from "@/types/mods"
import { siteConfig } from "@/config/site"
import { formatCount } from "@/lib/format"
import { collectionPageJsonLd } from "@/lib/json-ld"
import { getModuleUrl } from "@/lib/module-url"
import { getAllModuleMetadata, getLatestSemester } from "@/lib/server/db/repo"
import { SectionHeading } from "@/components/header"
import ModsPage from "@/components/mods/mods-page"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

// The interactive browser is client-rendered (search/filter state lives in the
// URL), so it ships no module links in the HTML. The directory below is
// server-rendered so crawlers and no-JS visitors can reach every module page.
export const prerender = true

const { year, semester } = await getLatestSemester()
const modules = await getAllModuleMetadata(year, semester)

// Group by the letter prefix of the code (SC1005 -> SC).
const groups = new Map<string, { code: string; title: string }[]>()
for (const { code, title } of Object.values(modules)) {
  const prefix = /^[A-Z]+/.exec(code)![0]
  if (!groups.has(prefix)) groups.set(prefix, [])
  groups.get(prefix)!.push({ code, title })
}
const directory = [...groups.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(
    ([prefix, list]) =>
      [prefix, list.sort((a, b) => a.code.localeCompare(b.code))] as const
  )
const moduleCount = formatCount(Object.keys(modules).length)
const coverage = `AY${year} Semester ${semester} with ${moduleCount} modules`

// The first cards of the default view (current semester, no filters), in the
// order the client list shows them. Rendering these in the HTML lets the page
// paint real content without waiting for hydration and the modules.json fetch.
const INITIAL_CARDS = 12
const { modules: allModules } = JSON.parse(
  await readFile("public/data/api/modules.json", "utf-8")
) as { modules: AllModule[] }
const initialModules = allModules
  .filter((m) => m.isCurrentSemester)
  .slice(0, INITIAL_CARDS)

const modsJsonLd = collectionPageJsonLd({
  name: siteConfig.metatags.mods.title,
  description: siteConfig.metatags.mods.desc,
  path: "/mods"
})
---

<BaseLayout
  title={siteConfig.metatags.mods.title}
  description={siteConfig.metatags.mods.desc}
  canonical="/mods"
  ogImage={`${siteConfig.url}/og/mods.png`}
  ogImageAlt="NTUMods module browser searching NTU modules, listing Digital Logic and other SC modules">
  <JsonLd data={modsJsonLd} />
  <ModsPage client:load initialModules={initialModules} />

  <section class="mt-12 space-y-3" aria-labelledby="mods-about">
    <SectionHeading id="mods-about">
      About the NTU module browser
    </SectionHeading>
    <p class="text-muted-foreground text-sm leading-relaxed text-pretty">
      Search every module offered at NTU by code or title, and narrow the
      results by module type, school, level, day and time. Each module page
      lists its academic units, prerequisites, mutually exclusive modules, exam
      date, and every class index with its timeslots and venues.
    </p>
    <p class="text-muted-foreground text-sm leading-relaxed text-pretty">
      The browser currently covers {coverage}, and earlier semesters are
      available back to AY2014. Module data comes from NTU's public course and
      exam timetables and is refreshed each semester. Add any module straight to
      a timetable plan from the results.
    </p>
  </section>

  <details class="mt-10 border-t pt-4">
    <summary
      class="text-muted-foreground hover:text-foreground cursor-pointer text-sm transition-colors">
      Browse all {moduleCount} modules by code
    </summary>
    <div class="mt-3 grid gap-x-6 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
      {
        directory.map(([prefix, list]) => (
          <details class="text-sm">
            <summary class="text-muted-foreground hover:text-foreground cursor-pointer py-1">
              {prefix}
              <span class="text-muted-foreground/70 ml-1">({list.length})</span>
            </summary>
            <ul class="mb-2 space-y-1 pl-4 text-xs">
              {list.map(({ code, title }) => (
                <li>
                  <a href={getModuleUrl(code)} class="hover:underline">
                    <span class="text-muted-foreground font-mono">{code}</span>{" "}
                    {title}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </details>
</BaseLayout>

---
import { siteConfig } from "@/config/site"
import ScreenshotPageContent from "@/components/screenshot/screenshot-page-content"
import MinimalLayout from "@/astro/layouts/MinimalLayout.astro"

export const prerender = true
---

<MinimalLayout
  title={siteConfig.metatags.screenshot.title}
  description={siteConfig.metatags.screenshot.desc}
  canonical="/screenshot">
  <ScreenshotPageContent client:load />
</MinimalLayout>

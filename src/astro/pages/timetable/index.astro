---
import {
  ArrowRight,
  CalendarPlus,
  ChevronDown,
  Footprints,
  GraduationCap,
  Layers,
  ListChecks,
  Lock,
  Search,
  Share2,
  Wand2
} from "lucide-react"

import { siteConfig } from "@/config/site"
import { formatCount } from "@/lib/format"
import { webApplicationJsonLd } from "@/lib/json-ld"
import { LATEST_SEMESTER_LABEL } from "@/lib/semesters"
import { getLatestSemester, getSemesterCounts } from "@/lib/server/db/repo"
import TimetablePageContent from "@/components/timetable/timetable-page-content"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const { year, semester } = await getLatestSemester()
const counts = await getSemesterCounts(year, semester)

const STEPS = [
  {
    title: "Add your modules",
    body: "Search by code or title, or paste a list of module codes to import them in one step.",
    Icon: Search
  },
  {
    title: "Pick your indexes",
    body: `Compare ${formatCount(counts.indexes)} class indexes across ${formatCount(counts.modules)} modules. Tap a class to try another index. Clashes are flagged as soon as they appear.`,
    Icon: ListChecks
  },
  {
    title: "Lock what you want",
    body: "Lock the indexes you have already settled on, so generating a plan keeps them.",
    Icon: Lock
  },
  {
    title: "Generate a plan",
    body: "Build clash-free combinations that respect free days, lunch breaks and time slots you want to keep empty.",
    Icon: Wand2
  },
  {
    title: "Add your own blocks",
    body: "Block out CCA, gym, work or outside classes as custom blocks, and see any clash with your modules.",
    Icon: CalendarPlus
  },
  {
    title: "Check the walks",
    body: "See your day on the campus map, and whether the gap between two classes is long enough to walk it.",
    Icon: Footprints
  },
  {
    title: "Check exam dates",
    body: "The module table under your timetable lists each module's AU and exam date and time, with your total AUs.",
    Icon: GraduationCap
  },
  {
    title: "Keep several plans",
    body: "Keep up to five plans, give each a name, and duplicate one to try a variation without losing it.",
    Icon: Layers
  },
  {
    title: "Share and export",
    body: "Share a plan by link, add it to your calendar as an .ics file, or save it as a phone wallpaper.",
    Icon: Share2
  }
]

const GUIDES = [
  {
    href: "/articles/how-to-plan-for-modules",
    title: "How to Plan NTU Modules Before STARS Opens",
    description:
      "Step-by-step workflow for building your semester plan — from mapping AU requirements to locking in lab indexes before bidding opens."
  },
  {
    href: "/articles/ntu-stars-guide",
    title: "NTU STARS: How the Registration System Works",
    description:
      "What happens in each STARS round, how to prepare your shortlist, and what to do when your first choice fills up."
  },
  {
    href: "/articles/ntu-academic-calendar-ay2026",
    title: "NTU Academic Calendar AY2026/2027",
    description:
      "Key dates for Semester 1 and 2 — semester start and end, recess week, exam period, and STARS round timing."
  },
  {
    href: "/articles/ntu-timetable-planner-redesign",
    title: "NTU Timetable Planner Redesign",
    description:
      "Walking times between classes, named plans, a single toolbar and a new Appearance dialog: what changed and what you can do now."
  },
  {
    href: "/articles/ntu-timetable-planner-guide",
    title: "NTU Timetable Planner Guide",
    description:
      "How to use NTUMods to search modules, compare indexes, detect clashes, and export your schedule to calendar."
  }
]
---

<BaseLayout
  title={siteConfig.metatags.timetable.title}
  description={siteConfig.metatags.timetable.desc}
  canonical="/timetable"
  lockZoom
  ogImage={`${siteConfig.url}/og/timetable.png`}
  ogImageAlt="NTUMods timetable planner showing a weekly NTU class schedule with lectures, tutorials and labs">
  <JsonLd
    data={webApplicationJsonLd({
      path: "/timetable",
      description: siteConfig.metatags.timetable.desc,
      featureList: [
        "Compare class indexes and spot clashes",
        "Generate clash-free timetables",
        "Walking time between classes on the campus map",
        "Custom blocks for CCA, gym and work",
        "Up to five named plans",
        "Share by link and export to calendar"
      ]
    })}
  />
  <TimetablePageContent client:load />

  <section class="mt-12 space-y-6" aria-labelledby="timetable-how">
    <div class="space-y-1.5">
      <h2 id="timetable-how" class="text-lg font-semibold tracking-tight">
        How the NTUMods timetable planner works
      </h2>
      <p
        class="text-muted-foreground max-w-2xl text-sm leading-relaxed text-pretty">
        A free timetable planner for Nanyang Technological University students.
        Build your plan, check it for clashes, and see how it plays out on
        campus before STARS registration opens.
      </p>
    </div>

    <ul
      id="timetable-steps"
      class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 max-sm:[&:not([data-open])>li:nth-child(n+4)]:hidden">
      {
        STEPS.map(({ title, body, Icon }) => (
          <li class="bg-card flex gap-3 rounded-xl border p-4">
            <span
              class="bg-muted/50 flex size-9 shrink-0 items-center justify-center rounded-lg border"
              aria-hidden="true">
              <Icon className="text-primary size-4" />
            </span>
            <div class="min-w-0 space-y-1">
              <h3 class="text-sm font-semibold">{title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed text-pretty">
                {body}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <button
      id="timetable-steps-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="timetable-steps"
      class="hover:bg-accent text-foreground -mt-3 flex h-9 w-full cursor-pointer items-center justify-center gap-1.5 rounded-lg border text-sm font-medium transition-colors sm:hidden">
      <span data-label>Read more</span>
      <ChevronDown className="size-4 transition-transform" data-chevron />
    </button>

    <p
      class="text-muted-foreground max-w-3xl border-t pt-5 text-xs leading-relaxed text-pretty">
      Timetables are stored in your browser, so no account is needed and your
      plan stays on your device. NTUMods is independent and is not affiliated
      with NTU. It does not perform registration, so you still register through
      STARS.
    </p>
  </section>

  <section class="mt-12 space-y-4" aria-labelledby="timetable-guides">
    <div class="space-y-1">
      <h2 id="timetable-guides" class="text-lg font-semibold tracking-tight">
        Planning guides
      </h2>
      <p class="text-muted-foreground text-sm">
        {LATEST_SEMESTER_LABEL} · {formatCount(counts.modules)} modules · {
          formatCount(counts.indexes)
        } class indexes
      </p>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      {
        GUIDES.map(({ href, title, description }) => (
          <a
            href={href}
            class="bg-card hover:bg-accent group flex flex-col gap-2 rounded-xl border p-5 transition-colors">
            <h3 class="text-sm leading-snug font-semibold">{title}</h3>
            <p class="text-muted-foreground text-sm leading-relaxed text-pretty">
              {description}
            </p>
            <span class="text-primary mt-auto inline-flex items-center gap-1 pt-1 text-sm font-medium">
              Read the guide
              <ArrowRight className="size-3.5 transition-transform group-hover:translate-x-0.5" />
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  // On phones the steps stop after three; the rest are in the page already.
  const list = document.getElementById("timetable-steps")
  const toggle = document.getElementById("timetable-steps-toggle")
  toggle?.addEventListener("click", () => {
    const open = list?.toggleAttribute("data-open")
    toggle.setAttribute("aria-expanded", String(Boolean(open)))
    const label = toggle.querySelector("[data-label]")
    if (label) label.textContent = open ? "Show less" : "Read more"
    toggle.querySelector("[data-chevron]")?.classList.toggle("rotate-180", open)
  })
</script>

---
import { siteConfig } from "@/config/site"
import { collectionPageJsonLd } from "@/lib/json-ld"
import Header, { SectionHeading } from "@/components/header"
import ToolsGrid from "@/components/tools/tools-grid"
import JsonLd from "@/astro/components/JsonLd.astro"
import BaseLayout from "@/astro/layouts/BaseLayout.astro"

export const prerender = true

const { title, desc } = siteConfig.metatags.tools

const MORE = [
  {
    href: "/timetable",
    title: "Timetable Planner",
    desc: "Build a clash-free STARS timetable."
  },
  {
    href: "/exams",
    title: "Exam Schedule",
    desc: "Check exam dates and times by module."
  },
  {
    href: "/links",
    title: "Student Links",
    desc: "STARS, NTULearn, Degree Audit and the FGO portal."
  },
  {
    href: "/articles",
    title: "Articles",
    desc: "Guides on FGO, BDEs, Common Core and more."
  }
]
---

<BaseLayout
  title={title}
  description={desc}
  canonical="/tools"
  ogImage={`${siteConfig.url}/og/links.png`}
  ogImageAlt="NTUMods student tools: FGO Optimiser and timetable wallpaper maker"
  size="md"
  containerClassName="space-y-6">
  <JsonLd
    data={collectionPageJsonLd({
      name: title,
      description: desc,
      path: "/tools",
      items: siteConfig.tools.map((tool) => ({
        name: tool.name,
        url: `${siteConfig.url}${tool.href}`
      }))
    })}
  />
  <Header
    title="NTU Student Tools"
    subtitle="Free tools for grades, CGPA and timetables. Everything runs in your browser, nothing you enter is uploaded, and there is no login."
  />

  <div>
    <ToolsGrid client:idle />
  </div>

  <section class="space-y-3" aria-labelledby="more-tools">
    <SectionHeading id="more-tools"> More for NTU students </SectionHeading>
    <div class="grid gap-3 sm:grid-cols-2">
      {
        MORE.map(({ href, title, desc }) => (
          <a
            href={href}
            class="hover:bg-accent group flex items-start justify-between gap-3 rounded-2xl border p-4 transition-colors">
            <span class="min-w-0 space-y-1">
              <span class="block text-sm font-semibold">{title}</span>
              <span class="text-muted-foreground block text-sm">{desc}</span>
            </span>
            <span class="text-muted-foreground mt-0.5 shrink-0">→</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Presence of this file skips Cloudflare's framework auto-detect entirely —
  // needed because the repo still has next.config.js alongside astro.config.mjs
  // (Next + Astro coexist during the migration), which made auto-detect bail
  // with "multiple frameworks were found: Astro, Next.js".
  "name": "ntu-mods",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Matches the adapter's own generated dist/server/wrangler.json (paths
  // re-rooted from repo root instead of dist/server/) — @astrojs/cloudflare
  // with output:"server" emits a plain entry.mjs, not Pages-style _worker.js.
  "main": "./dist/server/entry.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  }
}

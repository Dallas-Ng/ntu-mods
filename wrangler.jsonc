{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deliberately has no "main"/"assets"/"build" — @astrojs/cloudflare bundles
  // @cloudflare/vite-plugin into the astro build pipeline, and that plugin
  // auto-loads this file too. If "main" were set here (even correctly, to
  // dist/server/entry.mjs), the plugin eagerly validates it exists during
  // astro's sync step, which runs *before* astro build has generated that
  // file — the build crashes trying to validate its own output as an input.
  // Omitting "main" makes the plugin treat this as an assets-only config
  // (see resolveWorkerType in @cloudflare/vite-plugin), which skips that
  // check and lets the build finish normally.
  //
  // The adapter emits its own correct, self-contained wrangler.json in
  // dist/server/ after a successful build (real main + assets paths,
  // relative to dist/server/). Deploy using THAT file, not this one:
  //   Build command:  yarn build
  //   Deploy command: npx wrangler deploy --config dist/server/wrangler.json
  "name": "ntu-mods",
  // Keep the production workers.dev route off — deploy re-generates
  // dist/server/wrangler.json from this file each time, so leaving this
  // unset (wrangler defaults to true) silently re-enables the route on
  // every deploy even after manually disabling it in the dashboard.
  // Production traffic must only ever reach the app via the ntumods.com
  // custom domain (attached in the dashboard, not here).
  "workers_dev": false,
  // Preview URLs are a separate toggle from workers_dev, but default to
  // matching it when unset — so leaving this out silently killed PR/branch
  // preview deployments too. Force it on so Workers Builds keeps producing
  // *.workers.dev preview links for non-production branches, without
  // touching the workers_dev route above.
  "preview_urls": true,
  "compatibility_date": "2025-11-01",
  // Workers Cache is config-as-code only (no dashboard-only toggle) —
  // unset here means off, so the Cache-Control headers this app already
  // sets (404.astro, [semester].astro, public/_headers) do nothing without
  // this. Same deploy-overwrites-dashboard trap as workers_dev above.
  "cache": { "enabled": true },
  // disable_nodejs_process_v2 works around a known upstream bug (astro
  // issues #14511, #15434): nodejs_compat's newer `process` shim ("process
  // v2") makes Astro's internal isNode check misidentify workerd as Node,
  // so on-demand pages render as a Node-style async iterable instead of a
  // Web ReadableStream — Response can't accept that, and silently
  // stringifies it to the literal text "[object Object]".
  "compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
  // Source of truth for all module data. The on-demand snapshot route
  // (src/lib/server/edge/get-module-snapshot.ts) queries it at request time
  // through this binding; prerendered routes query the same schema at build
  // time through node:sqlite against a local copy pulled with `yarn db:pull`.
  //
  // "remote": true makes `astro dev` query this binding over the network
  // rather than an empty local D1 — without it the on-demand route errors in
  // dev with "no such table: offerings". Safe because that route only ever
  // reads. (Unrelated: the loader scripts default writes to a separate
  // ntu-mods-dev database, so experiments never touch what is serving
  // traffic — that database has no binding here.)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ntu-mods",
      "database_id": "c18f73e4-8b03-43d2-acf1-4b03c81f94e8",
      "migrations_dir": "db/migrations",
      "remote": true
    }
  ],
  // Worker Previews (`wrangler preview`) don't inherit bindings from the
  // top level — D1/KV/vars must be redeclared here or previews run with no
  // DB. Previews deliberately point at the production database: the
  // on-demand snapshot route only reads, so a preview can't change data.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ntu-mods",
        "database_id": "c18f73e4-8b03-43d2-acf1-4b03c81f94e8",
        "remote": true
      }
    ]
  },
  // Per-IP caps for the public routes (see src/lib/server/guard.ts). Cached
  // responses are served before the worker runs, so these only count real
  // work. Local to each Cloudflare location, so they blunt abuse rather than
  // cap it; add a WAF rule for a global limit.
  "ratelimits": [
    {
      "name": "MODULE_API_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "FEEDBACK_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "VIEWS_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "WALK_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // The MODULE_DATA KV namespace (98c8dfc5fcfb4dd180c30d37b4d000aa) held
  // per-module slices of the semester JSON files, to avoid fetching and
  // parsing a whole ~3MB file per request. D1 indexes those lookups directly,
  // so the binding is gone. The namespace itself still exists and can be
  // re-bound if this ever needs reverting.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
